.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 26px;
    color: rgb(181, 124, 124);
    -unity-font-style: bold;
}

.preview-cost-label {
    position: absolute;
    bottom: auto;
    left: auto;
    transform: ;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(67, 123, 154, 0.6);
    border-radius: 4px;
    color: rgb(181, 124, 124);
    unity-font-style: bold;
    font-size: 26px;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: space-around;
    align-self: center;
    align-content: center;
    -unity-text-align: middle-center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(208, 210, 165);
    border-right-color: rgb(208, 210, 165);
    border-top-color: rgb(208, 210, 165);
    border-bottom-color: rgb(208, 210, 165);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Font/Kenney%20Future%20Narrow.ttf?fileID=12800000&guid=c4bbc2b151f7a754082a4e6f6d8ed32e&type=3#Kenney Future Narrow");
    letter-spacing: -16px;
}
