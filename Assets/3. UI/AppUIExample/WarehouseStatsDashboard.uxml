<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:appui="Unity.AppUI.UI">
    <ui:Style src="WarehouseStatsDashboard.uss" />
    <appui:Panel name="dashboard-root" class="dashboard-root">
        <appui:Heading text="Warehouse Stats" size="L" style="margin-bottom: 24px;" />

        <!-- Finance Section -->
        <appui:Heading text="FINANCE" size="S" class="section-header" />
        <ui:VisualElement class="stat-card">
            <ui:VisualElement class="stat-row">
                <appui:Text text="Capital" size="M" />
                <appui:Text name="capitalValue" text="$100,000" size="L" weight="Bold" class="capital-text" />
            </ui:VisualElement>
            <ui:VisualElement class="stat-row" style="margin-bottom: 0;">
                <appui:Text text="Hourly Cost" size="S" />
                <appui:Text name="hourlyCostValue" text="-$50" size="S" class="cost-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Time Section -->
        <appui:Heading text="SIMULATION TIME" size="S" class="section-header" />
        <ui:VisualElement class="stat-card">
            <ui:VisualElement class="stat-row">
                <appui:Text name="dayValue" text="Day 1" size="M" weight="Bold" />
                <appui:Text name="timeValue" text="08:00" size="M" />
            </ui:VisualElement>
            <appui:LinearProgress name="hourProgress" value="33" title="Hour Progress" style="margin-top: 8px;" />

            <appui:ActionGroup justified="true" style="margin-top: 16px;">
                <appui:ActionButton name="pauseTime" icon="pause" variant="Quiet" />
                <appui:ActionButton name="playTime" icon="play" variant="Quiet" selected="true" />
                <appui:ActionButton name="fastForwardTime" icon="fast-forward" variant="Quiet" />
            </appui:ActionGroup>
        </ui:VisualElement>

        <!-- Operations Section -->
        <appui:Heading text="DAILY PERFORMANCE" size="S" class="section-header" />
        <ui:VisualElement class="performance-card">
            <appui:Text text="Spending Today" size="S" style="margin-bottom: 4px;" />
            <appui:Text name="spentTodayValue" text="$0" size="M" weight="Bold" />
            <ui:VisualElement class="activity-feed">
                 <appui:Text text="Recent Activity..." size="S" class="muted-text" style="font-style: italic;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <appui:ActionButton label="Export Report" variant="Primary" style="margin-top: 24px;" />
    </appui:Panel>
</ui:UXML>
