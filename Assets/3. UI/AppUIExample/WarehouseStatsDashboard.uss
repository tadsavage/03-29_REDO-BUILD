.dashboard-root {
    width: 300px;
    height: 100%;
    padding: 16px;
    background-color: var(--appui-background-level-1);
}

.section-header {
    margin-bottom: 8px;
    color: var(--appui-foreground-muted);
}

.stat-card {
    margin-bottom: 24px;
    padding: 12px;
    background-color: var(--appui-background-level-2);
    border-radius: 8px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.capital-text {
    color: var(--appui-positive);
}

.cost-text {
    color: var(--appui-negative);
}

.performance-card {
    flex-grow: 1;
    padding: 12px;
    background-color: var(--appui-background-level-2);
    border-radius: 8px;
}

.activity-feed {
    flex-grow: 1;
    margin-top: 12px;
    border-top-width: 1px;
    border-color: var(--appui-background-level-3);
    padding-top: 8px;
}

.muted-text {
    color: var(--appui-foreground-muted);
}
