/* Fixed 100px height = no layout shift when typing */

.slot-root {
    flex-direction: row; align-items: center;
    height: 100px; min-height: 100px; max-height: 100px;
    padding: 8px 12px; margin-bottom: 6px;
    background-color: rgba(255,255,255,0.04);
    border-width: 1px; border-color: rgba(255,255,255,0.08);
    border-radius: 6px; overflow: hidden;
}
.slot-root:hover {
    background-color: rgba(212,135,77,0.08); border-color: rgba(212,135,77,0.35);
}

.slot-index-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium")
    font-size: 11px; letter-spacing: -4px; color: rgba(255,255,255,0.3);
    width: 52px; min-width: 52px; -unity-text-align: middle-center; flex-shrink: 0;
}

.thumbnail-image {
    width: 142px; min-width: 142px; height: 80px; min-height: 80px;
    border-radius: 4px; border-width: 1px; border-color: rgba(255,255,255,0.1);
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; margin-right: 12px;
}

.empty-slot-overlay {
    position: absolute; left: 64px; top: 0; bottom: 0; width: 142px;
    align-items: center; justify-content: center;
}
.empty-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 12px; letter-spacing: -4px; color: rgba(255,255,255,0.2);
}

.info-column {
    flex-grow: 1; flex-shrink: 1; justify-content: center;
    margin-right: 12px; overflow: hidden;
}

.save-name-field {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 15px; letter-spacing: -4px; color: #F0E6D3;
    height: 30px; min-height: 30px; max-height: 30px; margin: 0; padding: 4px 8px;
    background-color: rgba(255,255,255,0.06);
    border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 3px;
}
.save-name-field:focus {
    border-color: #D4874D; background-color: rgba(212,135,77,0.1);
}
.save-name-field > .unity-text-field__input {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 15px; letter-spacing: -4px; color: #F0E6D3;
    background-color: transparent; border-width: 0; padding: 0; margin: 0;
}

.timestamp-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 11px; letter-spacing: -4px; color: rgba(255,255,255,0.4);
    margin-top: 4px; padding-left: 8px;
}

.button-column {
    flex-direction: column; align-items: stretch;
    width: 90px; min-width: 90px; flex-shrink: 0;
}

.action-button {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 13px; letter-spacing: -4px; color: #F0E6D3; height: 34px;
    margin-bottom: 4px; background-color: rgba(212,135,77,0.35);
    border-width: 1px; border-color: #D4874D; border-radius: 4px;
    -unity-text-align: middle-center;
}
.action-button:hover { background-color: rgba(212,135,77,0.6); }
.action-button:disabled {
    color: rgba(255,255,255,0.2); background-color: rgba(255,255,255,0.03);
    border-color: rgba(255,255,255,0.08);
}

.delete-button {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 11px; letter-spacing: -4px; color: #AA6666; height: 28px;
    background-color: rgba(170,60,60,0.1);
    border-width: 1px; border-color: rgba(170,60,60,0.25); border-radius: 4px;
    -unity-text-align: middle-center;
}
.delete-button:hover {
    color: #DD8888; background-color: rgba(170,60,60,0.25);
    border-color: rgba(170,60,60,0.5);
}
