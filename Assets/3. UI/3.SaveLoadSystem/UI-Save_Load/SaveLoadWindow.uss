/* --- FULL-SCREEN OVERLAY --- */
.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(30, 30, 30, 0.5);
    align-items: center;
    justify-content: center;
}

/* --- MODAL PANEL (fixed size = no layout shift) --- */
.modal-panel {
    width: 720px;
    height: 540px;
    background-color: rgba(35, 35, 40, 0.95);
    border-width: 2px;
    border-color: #D4874D;
    border-radius: 8px;
    translate: 0 -5%;
    flex-shrink: 0;
    overflow: hidden;
}

/* --- TITLE BAR (flex-shrink: 0 = never collapses) --- */
.title-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px 8px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(212, 135, 77, 0.4);
    flex-shrink: 0;
}

.title-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney Future Narrow.ttf");
    font-size: 22px;
    letter-spacing: -4px;
    color: #F0E6D3;
    -unity-text-align: middle-left;
}

.close-button {
    width: 32px; height: 32px;
    font-size: 18px;
    color: #AAAAAA;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    -unity-text-align: middle-center;
}
.close-button:hover {
    color: #FFFFFF;
    background-color: rgba(212, 135, 77, 0.3);
    border-color: #D4874D;
}

/* --- TAB BAR (flex-shrink: 0 = never collapses) --- */
.tab-bar {
    flex-direction: row;
    padding: 8px 16px 4px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
}

.tab-button {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney Future Narrow.ttf");
    font-size: 14px;
    letter-spacing: -4px;
    padding: 6px 20px;
    margin-right: 8px;
    border-radius: 4px 4px 0 0;
    border-width: 1px;
    border-bottom-width: 0;
}

.tab-active {
    color: #F0E6D3;
    background-color: rgba(212, 135, 77, 0.25);
    border-color: #D4874D;
}

.tab-inactive {
    color: #888888;
    background-color: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
}
.tab-inactive:hover {
    color: #BBBBBB;
    background-color: rgba(255, 255, 255, 0.06);
}

/* --- SLOT SCROLL VIEW --- */
.slot-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 8px 12px;
}

.slot-container {
    flex-direction: column;
}

/* --- CONFIRMATION OVERLAY (scoped to modal-panel, not full screen) --- */
.confirm-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.confirm-panel {
    width: 320px;
    padding: 24px;
    background-color: rgba(40, 40, 45, 0.98);
    border-width: 2px;
    border-color: #D4874D;
    border-radius: 8px;
    align-items: center;
}

.confirm-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney Future Narrow.ttf");
    font-size: 18px;
    letter-spacing: -4px;
    color: #F0E6D3;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.confirm-buttons {
    flex-direction: row;
}

.confirm-button {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney Future Narrow.ttf");
    font-size: 14px;
    letter-spacing: -4px;
    padding: 8px 28px;
    margin: 0 8px;
    border-radius: 4px;
    border-width: 1px;
}

.confirm-yes {
    color: #FFFFFF;
    background-color: rgba(212, 135, 77, 0.6);
    border-color: #D4874D;
}
.confirm-yes:hover {
    background-color: rgba(212, 135, 77, 0.85);
}

.confirm-no {
    color: #CCCCCC;
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
}
.confirm-no:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.15);
}
