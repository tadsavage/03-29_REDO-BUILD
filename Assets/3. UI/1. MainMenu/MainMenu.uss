/* ═══════════════════════════════════════════════════════════════
   FORK IT!  —  Main Menu  (proto)
   FarmSim warmth meets Two Point Hospital personality
   ═══════════════════════════════════════════════════════════════ */

/* ── FONTS ──────────────────────────────────────────────────────
   LilitaOne  = chunky display / titles / buttons
   Fredoka    = body / hints / subtle text
   ─────────────────────────────────────────────────────────────── */
@font-face {
    font-family: "LilitaOne";
    src: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
}

/* ── FLOATING TOOLTIP ───────────────────────────────────────── */
.tooltip-label {
    position: absolute;
    background-color: rgba(30, 38, 46, 0.95);
    border-width: 1px;
    border-color: #CFE2F0;
    border-radius: 6px;
    padding: 5px 10px;
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px;
    color: #CFE2F0;
    -unity-text-align: middle-center;
}

/* ── ROOT OVERLAY ────────────────────────────────────────────── */
.root-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: #41505E;
}

/* ── MAIN PANEL ──────────────────────────────────────────────── */
.main-panel {
    align-items: center;
    justify-content: center;
    width: 820px;
    background-color: rgba(30, 38, 46, 0.96);
    border-width: 3px;
    border-color: #5C9BC4;
    border-radius: 18px;
    padding-top: 24px;
    padding-bottom: 30px;
    padding-left: 36px;
    padding-right: 36px;
}

/* ── TITLE ───────────────────────────────────────────────────────
   Sits absolutely over the TOP of the rats image, landed at an angle.
   Intro: flies in big & straight (.title-label--intro), then transitions
   down to landed size/angle when the class is removed in C#.
   ─────────────────────────────────────────────────────────────── */
.title-label {
    position: absolute;
    top: -46px;
    left: 0;
    right: 0;
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 168px;
    color: #EAF4FF;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 0;
    -unity-font-style: normal;
    rotate: -7deg;
    scale: 1 1;
    opacity: 1;
    transition: scale 0.6s ease-out, rotate 0.6s ease-out, opacity 0.45s ease-out;
}

/* initial fly-in state (~300pt feel, straight, fading up) */
.title-label--intro {
    scale: 1.78 1.78;
    rotate: 0deg;
    opacity: 0;
}

/* ── TAGLINE (caption — sits at the bottom of the image, one line) ── */
.tagline-label {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 19px;
    color: rgba(207, 226, 240, 0.78);
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    -unity-text-letter-spacing: 0;
    white-space: nowrap;
    margin-top: 10px;
    margin-bottom: 16px;
}

/* ── LOGO (rats image — large, dominates the upper card) ─────────── */
.logo-container {
    position: relative;
    width: 500px;
    height: 500px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    margin-top: 56px;
    margin-bottom: 4px;
}

.logo-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── MENU BUTTONS ────────────────────────────────────────────── */
.button-column {
    align-items: stretch;
    width: 440px;
}

.menu-btn {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 22px;
    height: 50px;
    border-radius: 4px;
    border-width: 0;
    border-bottom-width: 5px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 2px;
    transition: translate 0.05s, border-bottom-width 0.05s;
}
.menu-btn:hover  { translate: 0 -2px; }
.menu-btn:active { translate: 0 2px; border-bottom-width: 1px; }

/* Consistent graphite / steel-blue palette (light-blue accent = primary) */
.menu-btn-green  { background-color: #4C90C0; border-bottom-color: #2C5E82; color: #FFFFFF; }
.menu-btn-blue   { background-color: #5A7184; border-bottom-color: #36444F; color: #FFFFFF; }
.menu-btn-grey   { background-color: #566573; border-bottom-color: #333E47; color: #ECEFF1; }
.menu-btn-red    { background-color: #3F4C59; border-bottom-color: #232C33; color: #DCE6EF; }
.menu-btn-orange { background-color: #B5743A; border-bottom-color: #7A4C22; color: #FDE8CC; }

.menu-btn-green:hover  { background-color: #5BA6D8; }
.menu-btn-blue:hover   { background-color: #6A859A; }
.menu-btn-grey:hover   { background-color: #657686; }
.menu-btn-red:hover    { background-color: #4D5C6A; }
.menu-btn-orange:hover { background-color: #C67F42; }

/* ── VERSION STAMP ───────────────────────────────────────────── */
.version-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 12px;
    color: rgba(223, 235, 245, 0.2);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ── POPUP PANEL (shared base, top-right) ────────────────────── */
.popup-panel {
    position: absolute;
    top: 100px;
    right: 32px;
    width: 500px;
    background-color: rgba(30, 38, 46, 0.97);
    border-width: 2px;
    border-color: #CFE2F0;
    border-radius: 16px;
    padding: 24px 26px;
    flex-direction: column;
}

.popup-title {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 52px;
    color: #CFE2F0;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 2px;
}

/* ── NAME FIELD ──────────────────────────────────────────────── */
.popup-field {
    height: 48px;
    margin-bottom: 14px;
}
.popup-field .unity-base-text-field__input {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 24px;
    color: #EAF2F8;
    background-color: rgba(60, 75, 90, 0.4);
    border-width: 2px;
    border-color: rgba(207, 226, 240, 0.4);
    border-radius: 8px;
    padding-left: 12px;
    -unity-text-align: middle-left;
}
.popup-field:focus .unity-base-text-field__input { border-color: #CFE2F0; }

/* ── MODAL BACKDROP (welcome popup) ─────────────────────────── */
.modal-backdrop {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
}

/* ── WELCOME POPUP (centred card) ────────────────────────────── */
.popup-welcome {
    width: 1000px;
    background-color: rgba(30, 38, 46, 0.98);
    border-width: 4px;
    border-color: #CFE2F0;
    border-radius: 40px;
    padding: 64px 72px;
    align-items: center;
    flex-direction: column;
}

/* ── BOSS AVATAR ─────────────────────────────────────────────── */
.boss-avatar {
    width: 90px;
    height: 90px;
    border-radius: 45px;
    background-color: #2C353F;
    border-width: 3px;
    border-color: #CFE2F0;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
}

.boss-emoji {
    font-size: 48px;
    -unity-text-align: middle-center;
}

.welcome-boss-title {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 26px;
    color: rgba(92, 155, 196, 0.8);
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 4px;
    margin-bottom: 28px;
}

/* ── WELCOME TEXT ────────────────────────────────────────────── */
.welcome-text {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 28px;
    color: #EAF2F8;
    white-space: normal;
    margin-bottom: 40px;
    -unity-text-align: upper-left;
    width: 100%;
}

/* ── LOAD HINT ───────────────────────────────────────────────── */
.popup-hint {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 19px;
    color: rgba(207, 226, 240, 0.7);
    margin-bottom: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ── SAVE SLOT LIST ──────────────────────────────────────────── */
.save-slot-list {
    flex-direction: column;
    margin-bottom: 12px;
    max-height: 520px;
    overflow: hidden;
}

/* ── POPUP BUTTONS ───────────────────────────────────────────── */
.popup-btn {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 26px;
    height: 58px;
    border-radius: 4px;
    border-width: 0;
    border-bottom-width: 4px;
    margin-top: 6px;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 2px;
    width: 100%;
}
.popup-btn:active { translate: 0 2px; border-bottom-width: 1px; }

.popup-btn-green  { background-color: #4C90C0; border-bottom-color: #2C5E82; color: #FFFFFF; }
.popup-btn-grey   { background-color: #566573; border-bottom-color: #333E47; color: #ECEFF1; }
.popup-btn-orange { background-color: #B5743A; border-bottom-color: #7A4C22; color: #FDE8CC; }
.popup-btn-green:hover  { background-color: #5BA6D8; }
.popup-btn-grey:hover   { background-color: #657686; }
.popup-btn-orange:hover { background-color: #C67F42; }

.settings-action-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}
.settings-action-btn {
    flex: 1;
    margin-top: 0;
}
.settings-action-btn:first-child {
    margin-right: 6px;
}

/* ── SETTINGS ────────────────────────────────────────────────── */
.settings-section-header {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px;
    color: #5C9BC4;
    -unity-text-letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-top: 14px;
    margin-bottom: 8px;
}

.settings-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.gfx-btn {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px;
    flex: 1;
    height: 44px;
    border-radius: 4px;
    border-width: 0;
    border-bottom-width: 3px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}
.gfx-btn:active { translate: 0 2px; border-bottom-width: 1px; }

.gfx-btn-blue  { background-color: #3D7EA6; border-bottom-color: #285874; color: #FFFFFF; }
.gfx-btn-green { background-color: #4C90C0; border-bottom-color: #2C5E82; color: #FFFFFF; }
.gfx-btn-red   { background-color: #566573; border-bottom-color: #333E47; color: #FFFFFF; }
.gfx-btn-blue:hover  { background-color: #4A8FB8; }
.gfx-btn-green:hover { background-color: #5BA6D8; }
.gfx-btn-red:hover   { background-color: #657686; }

.gfx-btn--active {
    border-width: 2px;
    border-color: #CFE2F0;
    border-bottom-width: 4px;
}

.settings-dropdown {
    height: 40px;
    margin-bottom: 4px;
}
.settings-dropdown .unity-base-popup-field__input {
    background-color: rgba(60, 75, 90, 0.4);
    border-width: 2px;
    border-color: rgba(207, 226, 240, 0.4);
    border-radius: 8px;
    color: #EAF2F8;
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    padding-right: 28px;
}

.settings-dropdown .unity-base-popup-field__arrow {
    width: 16px;
    min-width: 16px;
    height: 16px;
    margin-right: 8px;
    -unity-background-image-tint-color: #CFE2F0;
    flex-shrink: 0;
    align-self: center;
}

.settings-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.settings-slider-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 15px;
    color: #EAF2F8;
    width: 55px;
    min-width: 55px;
}
.settings-slider {
    flex: 1;
    height: 24px;
}
.settings-slider > .unity-base-slider__input {
    flex-grow: 1;
    height: 24px;
    align-items: center;
}
.settings-slider .unity-base-slider__tracker {
    background-color: rgba(60, 75, 90, 0.5);
    border-radius: 4px;
    height: 6px;
}
.settings-slider .unity-base-slider__dragger {
    background-image: url("project://database/Assets/6.%20Art/UI/ForkSprite.png");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    width: 114px;
    height: 75px;
    top: -34px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── RESOLUTION CONFIRM OVERLAY ─────────────────────────────── */
.confirm-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.confirm-panel {
    width: 310px;
    background-color: rgba(30, 38, 46, 0.97);
    border-width: 2px;
    border-color: #CFE2F0;
    border-radius: 16px;
    padding: 22px 24px 18px 24px;
    flex-direction: column;
    align-items: stretch;
}

.confirm-title {
    font-size: 30px;
    margin-bottom: 14px;
}

/* ── SAVE SLOT CARD (resume popup) ───────────────────────────── */
.save-slot-card {
    flex-direction: row;
    align-items: center;
    background-color: rgba(60, 75, 90, 0.35);
    border-width: 1px;
    border-color: rgba(207, 226, 240, 0.2);
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 8px;
}
.save-slot-card:hover {
    background-color: rgba(76, 144, 192, 0.18);
    border-color: rgba(207, 226, 240, 0.5);
}

/* ── THUMBNAIL ───────────────────────────────────────────────── */
.slot-thumb {
    width: 160px;
    height: 90px;
    border-radius: 4px;
    background-color: rgb(30, 38, 46);
    border-width: 1px;
    border-color: rgba(207, 226, 240, 0.3);
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
}
.slot-thumb--empty {
    align-items: center;
    justify-content: center;
    background-color: rgba(30, 38, 46, 0.5);
    border-color: rgba(207, 226, 240, 0.12);
}
.slot-thumb-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 12px;
    color: rgba(207, 226, 240, 0.35);
    -unity-text-align: middle-center;
}

/* ── SLOT INFO (name + timestamp) ─────────────────────────────── */
.slot-info {
    flex: 1;
    flex-direction: column;
    margin-left: 12px;
    margin-right: 8px;
    min-width: 0;
}
.slot-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 20px;
    -unity-font-style: bold;
    color: #EAF2F8;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}
.slot-filename {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 16px;
    color: rgba(207, 226, 240, 0.5);
    -unity-text-align: middle-left;
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
}
.slot-timestamp {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 11px;
    color: rgba(207, 226, 240, 0.55);
    -unity-text-align: middle-left;
    margin-top: 2px;
}

/* ── LOAD BUTTON ──────────────────────────────────────────────── */
.slot-load-btn {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf");
    font-size: 17px;
    height: 50px;
    min-width: 90px;
    border-radius: 4px;
    border-width: 0;
    border-bottom-width: 3px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 1px;
    flex-shrink: 0;
    margin-left: 8px;
    background-color: #4C90C0;
    border-bottom-color: #2C5E82;
    color: #FFFFFF;
}
.slot-load-btn:active { translate: 0 2px; border-bottom-width: 1px; }
.slot-load-btn:hover { background-color: #5BA6D8; }

/* kept for backwards compat but all render the same blue now */
.slot-load-btn-green  { background-color: #4C90C0; border-bottom-color: #2C5E82; color: #FFFFFF; }
.slot-load-btn-blue   { background-color: #4C90C0; border-bottom-color: #2C5E82; color: #FFFFFF; }
.slot-load-btn-orange { background-color: #4C90C0; border-bottom-color: #2C5E82; color: #FFFFFF; }
.slot-load-btn-purple { background-color: #4C90C0; border-bottom-color: #2C5E82; color: #FFFFFF; }
