    <ui:VisualElement name="BottomBar" class="buildmenu-bottom-bar" picking-mode="Position">
        <ui:VisualElement name="CategoryRow" class="buildmenu-category-row" picking-mode="Ignore"/>
        <ui:VisualElement name="UtilityRow" class="buildmenu-utility-row" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>
