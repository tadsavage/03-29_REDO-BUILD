.buildmenu-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

.buildmenu-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background-color: rgba(35, 35, 40, 0.95);
    border-top-width: 1px;
    border-top-color: rgba(212, 135, 77, 0.4);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    padding-left: 16px;
    padding-right: 16px;
    overflow: visible;
}

.buildmenu-category-row,
.buildmenu-utility-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    overflow: visible;
}

.buildmenu-category-button {
    width: 120px;
    height: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    opacity: 1;
    transition: background-color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease, transform 0.18s ease;
}

.buildmenu-category-button:hover {
    background-color: rgba(212, 135, 77, 0.12);
    border-color: rgba(212, 135, 77, 0.45);
    opacity: 0.95;
    transform: ;
    transition-duration: 0.5s;
}

.buildmenu-category-button.selected {
    background-color: rgba(212, 135, 77, 0.25);
    border-color: rgb(212, 135, 77);
    opacity: 1;
}

.buildmenu-category-icon {
    width: 96px;
    height: 88px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.buildmenu-category-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 16px;
    letter-spacing: -4px;
    -unity-font-style: normal;
    color: rgb(240, 230, 211);
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-utility-button {
    width: 84px;
    height: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    opacity: 1;
    transition: background-color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease, transform 0.18s ease;
}

.buildmenu-utility-button:hover {
    background-color: rgba(212, 135, 77, 0.12);
    border-color: rgba(212, 135, 77, 0.45);
    opacity: 0.95;
    transform: ;
    transition-duration: 0.5s;
}

.buildmenu-utility-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-bottom: 4px;
}

.buildmenu-utility-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 11px;
    letter-spacing: -4px;
    -unity-font-style: bold;
    color: rgb(240, 230, 211);
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-submenu {
    position: absolute;
    left: 0;
    opacity: 0;
    display: none;
    transition: opacity 0.25s ease-out;
}

.buildmenu-submenu-open {
    opacity: 1;
    display: flex;
}

.buildmenu-submenu-closed {
    opacity: 0;
    display: none;
}

.buildmenu-submenu-root {
    background-color: rgba(35, 35, 40, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(212, 135, 77, 0.4);
    padding: 6px;
    max-height: 320px;
}

.buildmenu-submenu-scroll {
    flex-grow: 1;
}

.buildmenu-item-button {
    width: 260px;
    height: 64px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 6px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    opacity: 1;
    transition: background-color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease, transform 0.18s ease;
}

.buildmenu-item-button:hover {
    background-color: rgba(212, 135, 77, 0.12);
    border-color: rgba(212, 135, 77, 0.45);
    opacity: 0.95;
    transform: ;
    transition-duration: 0.5s;
}

.buildmenu-item-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 10px;
}

.buildmenu-item-text {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.buildmenu-item-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 15px;
    letter-spacing: -4px;
    color: rgb(240, 230, 211);
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

.buildmenu-item-cost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Regular.ttf?fileID=12800000&guid=65659553c3e2aec4fa1368693dea6c68&type=3#Fredoka-Regular");
    font-size: 14px;
    letter-spacing: -4px;
    color: rgb(160, 255, 200);
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}
