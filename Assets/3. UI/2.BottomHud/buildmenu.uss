.buildmenu-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

.buildmenu-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background-color: rgba(35, 35, 40, 0.95);
    border-top-width: 1px;
    border-top-color: rgba(212, 135, 77, 0.4);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    padding-left: 16px;
    padding-right: 16px;
    pointer-events: auto;
}

.buildmenu-category-row,
.buildmenu-utility-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.buildmenu-category-button {
    width: 120px;
    height: 104px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    transition: background-color 0.12s ease, border-color 0.12s ease;
    top: auto;
}

.buildmenu-category-button:hover {
    background-color: rgba(212, 135, 77, 0.15);
    border-color: rgba(212, 135, 77, 0.4);
}

.buildmenu-category-button.selected {
    background-color: rgba(212, 135, 77, 0.25);
    border-color: rgb(212, 135, 77);
    padding-top: 0;
}

.buildmenu-category-icon {
    width: 96px;
    height: 88px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 2px;
    margin-top: 0;
}

.buildmenu-category-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney%20Future%20Narrow.ttf?fileID=12800000&guid=c4bbc2b151f7a754082a4e6f6d8ed32e&type=3#Kenney Future Narrow");
    font-size: 20px;
    letter-spacing: -4px;
    -unity-font-style: bold;
    color: rgb(240, 230, 211);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.buildmenu-utility-button {
    width: 84px;
    height: 84px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    transition: background-color 0.12s ease, border-color 0.12s ease;
    top: auto;
}

.buildmenu-utility-button:hover {
    background-color: rgba(212, 135, 77, 0.15);
    border-color: rgba(212, 135, 77, 0.4);
}

.buildmenu-utility-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 4px;
}

.buildmenu-utility-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney%20Future%20Narrow.ttf?fileID=12800000&guid=c4bbc2b151f7a754082a4e6f6d8ed32e&type=3#Kenney Future Narrow");
    font-size: 11px;
    letter-spacing: -4px;
    -unity-font-style: bold;
    color: rgb(240, 230, 211);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.buildmenu-submenu {
    position: absolute;
    left: 0;
    width: auto;
    z-index: 50;
    pointer-events: auto;
    transition-property: transform, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transform: ;
    opacity: 0;
    visibility: hidden;
}

.buildmenu-submenu-open {
    transform: ;
    opacity: 1;
    visibility: visible;
}

.buildmenu-submenu-closed {
    transform: ;
    opacity: 0;
    visibility: hidden;
}

.buildmenu-submenu-root {
    background-color: rgba(35, 35, 40, 0.95);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(212, 135, 77, 0.4);
    padding: 6px;
    max-height: 320px;
}

.buildmenu-submenu-scroll {
    flex-grow: 1;
}

.buildmenu-item-button {
    width: 260px;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 6px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 6px;
    transition: background-color 0.12s ease, border-color 0.12s ease;
    left: auto;
}

.buildmenu-item-button:hover {
    background-color: rgba(212, 135, 77, 0.15);
    border-color: rgba(212, 135, 77, 0.4);
}

.buildmenu-item-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 10px;
}

.buildmenu-item-text {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.buildmenu-item-name {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney%20Future%20Narrow.ttf?fileID=12800000&guid=c4bbc2b151f7a754082a4e6f6d8ed32e&type=3#Kenney Future Narrow");
    font-size: 15px;
    letter-spacing: -4px;
    -unity-font-style: bold;
    color: rgb(240, 230, 211);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.buildmenu-item-cost {
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney%20Future%20Narrow.ttf?fileID=12800000&guid=c4bbc2b151f7a754082a4e6f6d8ed32e&type=3#Kenney Future Narrow");
    font-size: 14px;
    letter-spacing: -4px;
    color: rgb(160, 255, 200);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.buildmenu-category-button.selected {
    animation-name: category-glow;
    animation-duration: 0.9s;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}
