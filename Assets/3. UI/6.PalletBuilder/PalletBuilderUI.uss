/*
WAREHOUSE THEME: Deep purple-charcoal base panel with gold accent border
Matches the Palia/Warehouse style of the main HUD.
*/
.pallet-builder-root {
    position: absolute;
    top: 100px;
    left: 50px;
    width: 480px;
    background-color: #2D2B3A;
    border-width: 2px;
    border-color: #ECC98A;
    border-radius: 12px;
    padding: 20px;
    color: #F5EEDB;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Regular.ttf?fileID=12800000&guid=65659553c3e2aec4fa1368693dea6c68&type=3#Fredoka-Regular");
}

.header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(236, 201, 138, 0.4);
    padding-bottom: 10px;
}

.header {
    font-size: 28px;
    -unity-font-style: bold;
    color: #FFFFFF;
    flex-grow: 1;
}

.close-button {
    width: 36px;
    height: 36px;
    background-color: rgba(255, 100, 100, 0.1);
    border-color: #ECC98A;
    border-radius: 18px;
    color: #FFFFFF;
    font-size: 22px;
    -unity-font-style: bold;
}

.close-button:hover {
    background-color: rgba(255, 100, 100, 0.4);
}

.input-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
    align-items: center;
}

.input-label {
    flex: 1;
    font-size: 18px;
    color: #F5EEDB;
    -unity-font-style: bold;
}

.input-field {
    flex: 1.4;
    height: 44px;
}

/* TARGET THE INPUT TEXT SPECIFICALLY */
.input-field .unity-base-text-field__input {
    background-color: rgba(90, 85, 110, 0.3);
    border-width: 2px;
    border-color: rgba(236, 201, 138, 0.5);
    color: #FFFFFF;
    border-radius: 6px;
    font-size: 22px;
    padding-left: 12px;
    -unity-text-align: middle-left;
}

.input-field:focus .unity-base-text-field__input {
    border-color: #ECC98A;
    background-color: rgba(90, 85, 110, 0.5);
}

.override-toggle {
    width: 32px;
    height: 32px;
}

.build-button {
    margin-top: 20px;
    height: 60px;
    background-color: #ECC98A;
    border-width: 2px;
    border-color: #F5EEDB;
    border-radius: 10px;
    color: #2D2B3A;
    font-size: 24px;
    -unity-font-style: bold;
    transition: background-color 0.1s, scale 0.1s;
}

.build-button:hover {
    background-color: #F5EEDB;
    scale: 1.03;
}

.build-button:active {
    background-color: #D4B475;
    scale: 0.97;
}

/* Prefab Selector Styles */
.prefab-dropdown {
    margin-top: 10px;
    margin-bottom: 16px;
    height: 48px;
}

.prefab-dropdown .unity-base-field__label {
    min-width: 140px;
    flex-grow: 0;
    font-size: 18px;
    color: #F5EEDB;
    -unity-font-style: bold;
}

/* Styled Dropdown Box */
.prefab-dropdown .unity-base-popup-field__input {
    flex: 1;
    background-color: #3D3B4A;
    border-width: 2px;
    border-color: #ECC98A;
    color: #FFFFFF;
    font-size: 22px;
    height: 100%;
    border-radius: 6px;
    padding-left: 12px;
}

/* Styled Arrow */
.prefab-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: #ECC98A;
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

/* 
STYLING THE POPUP MENU (Runtime) 
Note: The popup list is often part of a separate panel or added to the root.
We style general dropdown classes to ensure it matches.
*/
.unity-base-dropdown__container-inner {
    background-color: #2D2B3A;
    border-width: 2px;
    border-color: #ECC98A;
    border-radius: 6px;
}

.unity-base-dropdown__item {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 18px;
    padding: 8px;
}

.unity-base-dropdown__item:hover {
    background-color: #ECC98A;
    color: #2D2B3A;
}

.unity-base-dropdown__label {
    color: #FFFFFF;
}
