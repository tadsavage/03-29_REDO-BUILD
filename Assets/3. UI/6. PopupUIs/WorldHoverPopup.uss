/* ── FLOATING OBJECT HOVER POPUP ─────────────────────────
   Follows the cursor (+50px right, +50px down).
   Styled to match the game's Palia/gold aesthetic.
   ───────────────────────────────────────────────────────── */

.world-hover-popup {
    position: absolute;
    background-color: #2D2B3A;
    border-width: 2px;
    border-color: #ECC98A;
    border-radius: 8px;
    padding: 10px 14px;
    min-width: 180px;
    display: none;
    flex-direction: column;
    picking-mode: ignore;
    top: 0;
    left: 0;
}

.world-hover-popup.show {
    display: flex;
}

.world-hover-title {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 16px;
    color: #F5EEDB;
    margin-bottom: 5px;
}

.world-hover-cost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px;
    color: #ECC98A;
    margin-bottom: 2px;
}

.world-hover-hourlyCost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px;
    color: rgba(236, 201, 138, 0.55);
}
