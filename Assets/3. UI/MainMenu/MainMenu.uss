/* ═══════════════════════════════════════════════════════════════
   FORK IT!  —  Main Menu  (proto)
   FarmSim warmth meets Two Point Hospital personality
   ═══════════════════════════════════════════════════════════════ */

/* ── FONTS ──────────────────────────────────────────────────────
   LilitaOne  = chunky display / titles / buttons
   Fredoka    = body / hints / subtle text
   ─────────────────────────────────────────────────────────────── */
@font-face {
    font-family: "LilitaOne";
    src: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
}

/* ── FLOATING TOOLTIP ───────────────────────────────────────── */
.tooltip-label {
    position: absolute;
    background-color: rgba(28, 22, 12, 0.95);
    border-width: 1px;
    border-color: #ECC98A;
    border-radius: 6px;
    padding: 5px 10px;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 13px;
    color: #ECC98A;
    -unity-text-align: middle-center;
}

/* ── ROOT OVERLAY ────────────────────────────────────────────── */
.root-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: #C8B07A;
}

/* ── MAIN PANEL ──────────────────────────────────────────────── */
.main-panel {
    align-items: center;
    justify-content: center;
    width: 580px;
    background-color: rgba(28, 22, 12, 0.96);
    border-width: 3px;
    border-color: #D4874D;
    border-radius: 20px;
    padding-top: 36px;
    padding-bottom: 32px;
    padding-left: 36px;
    padding-right: 36px;
}

/* ── TITLE ───────────────────────────────────────────────────── */
.title-label {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
    font-size: 84px;
    color: #ECC98A;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 4px;
    margin-bottom: 0;
    -unity-font-style: normal;
}

/* ── TAGLINE ─────────────────────────────────────────────────── */
.tagline-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Regular.ttf?fileID=12800000&guid=65659553c3e2aec4fa1368693dea6c68&type=3#Fredoka-Regular");
    font-size: 14px;
    color: rgba(245, 238, 219, 0.5);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
    white-space: normal;
    max-width: 440px;
    margin-bottom: 20px;
    margin-top: 4px;
}

/* ── LOGO PLACEHOLDER ────────────────────────────────────────── */
.logo-container {
    width: 260px;
    height: 260px;
    background-color: rgba(212, 135, 77, 0.08);
    border-width: 2px;
    border-color: rgba(212, 135, 77, 0.3);
    border-radius: 14px;
    border-style: dashed;
    align-items: center;
    justify-content: center;
    margin-bottom: 26px;
}

.logo-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── MENU BUTTONS ────────────────────────────────────────────── */
.button-column {
    align-items: stretch;
    width: 400px;
}

.menu-btn {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
    font-size: 24px;
    height: 64px;
    border-radius: 12px;
    border-width: 0;
    border-bottom-width: 5px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 2px;
    transition: translate 0.05s, border-bottom-width 0.05s;
}
.menu-btn:hover  { translate: 0 -2px; }
.menu-btn:active { translate: 0 2px; border-bottom-width: 1px; }

.menu-btn-green  { background-color: #4CAF50; border-bottom-color: #2E7D32; color: #FFFFFF; }
.menu-btn-blue   { background-color: #1976D2; border-bottom-color: #0D47A1; color: #FFFFFF; }
.menu-btn-grey   { background-color: #546E7A; border-bottom-color: #263238; color: #ECEFF1; }
.menu-btn-red    { background-color: #C62828; border-bottom-color: #7F0000; color: #FFFFFF; }

.menu-btn-green:hover  { background-color: #66BB6A; }
.menu-btn-blue:hover   { background-color: #2196F3; }
.menu-btn-grey:hover   { background-color: #607D8B; }
.menu-btn-red:hover    { background-color: #EF5350; }

/* ── VERSION STAMP ───────────────────────────────────────────── */
.version-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Regular.ttf?fileID=12800000&guid=65659553c3e2aec4fa1368693dea6c68&type=3#Fredoka-Regular");
    font-size: 12px;
    color: rgba(245, 238, 219, 0.2);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ── POPUP PANEL (shared base, top-right) ────────────────────── */
.popup-panel {
    position: absolute;
    top: 32px;
    right: 32px;
    width: 360px;
    background-color: rgba(28, 22, 12, 0.97);
    border-width: 2px;
    border-color: #ECC98A;
    border-radius: 16px;
    padding: 24px 26px;
    flex-direction: column;
}

.popup-title {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
    font-size: 22px;
    color: #ECC98A;
    margin-bottom: 14px;
    -unity-text-align: middle-left;
}

/* ── NAME FIELD ──────────────────────────────────────────────── */
.popup-field {
    height: 48px;
    margin-bottom: 14px;
}
.popup-field .unity-base-text-field__input {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 18px;
    color: #F5EEDB;
    background-color: rgba(90, 75, 45, 0.4);
    border-width: 2px;
    border-color: rgba(236, 201, 138, 0.4);
    border-radius: 8px;
    padding-left: 12px;
    -unity-text-align: middle-left;
}
.popup-field:focus .unity-base-text-field__input { border-color: #ECC98A; }

/* ── MODAL BACKDROP (welcome popup) ─────────────────────────── */
.modal-backdrop {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

/* ── WELCOME POPUP (centred card) ────────────────────────────── */
.popup-welcome {
    width: 1000px;
    background-color: rgba(28, 22, 12, 0.98);
    border-width: 4px;
    border-color: #ECC98A;
    border-radius: 40px;
    padding: 64px 72px;
    align-items: center;
    flex-direction: column;
}

/* ── BOSS AVATAR ─────────────────────────────────────────────── */
.boss-avatar {
    width: 90px;
    height: 90px;
    border-radius: 45px;
    background-color: #3A2D1A;
    border-width: 3px;
    border-color: #ECC98A;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
}

.boss-emoji {
    font-size: 48px;
    -unity-text-align: middle-center;
}

.welcome-boss-title {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
    font-size: 26px;
    color: rgba(212, 135, 77, 0.8);
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 4px;
    margin-bottom: 28px;
}

/* ── WELCOME TEXT ────────────────────────────────────────────── */
.welcome-text {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 28px;
    color: #F5EEDB;
    white-space: normal;
    margin-bottom: 40px;
    -unity-text-align: upper-left;
    width: 100%;
}

/* ── LOAD HINT ───────────────────────────────────────────────── */
.popup-hint {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Regular.ttf?fileID=12800000&guid=65659553c3e2aec4fa1368693dea6c68&type=3#Fredoka-Regular");
    font-size: 13px;
    color: rgba(236, 201, 138, 0.7);
    margin-bottom: 12px;
    white-space: normal;
}

/* ── SAVE SLOT LIST ──────────────────────────────────────────── */
.save-slot-list {
    flex-direction: column;
    margin-bottom: 12px;
}

/* ── POPUP BUTTONS ───────────────────────────────────────────── */
.popup-btn {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
    font-size: 18px;
    height: 50px;
    border-radius: 10px;
    border-width: 0;
    border-bottom-width: 3px;
    margin-top: 4px;
    -unity-text-align: middle-center;
    -unity-text-letter-spacing: 1px;
    width: 100%;
}
.popup-btn:active { translate: 0 2px; border-bottom-width: 1px; }

.popup-btn-green { background-color: #4CAF50; border-bottom-color: #2E7D32; color: #FFFFFF; }
.popup-btn-grey  { background-color: #546E7A; border-bottom-color: #263238; color: #ECEFF1; }
.popup-btn-green:hover { background-color: #66BB6A; }
.popup-btn-grey:hover  { background-color: #607D8B; }

/* ── SETTINGS ────────────────────────────────────────────────── */
.settings-section-header {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
    font-size: 14px;
    color: #D4874D;
    -unity-text-letter-spacing: 2px;
    margin-top: 14px;
    margin-bottom: 8px;
}

.settings-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.gfx-btn {
    -unity-font: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/LilitaOne-Regular.ttf");
    font-size: 13px;
    flex: 1;
    height: 44px;
    border-radius: 8px;
    border-width: 0;
    border-bottom-width: 3px;
    margin-right: 6px;
    -unity-text-align: middle-center;
}
.gfx-btn:active { translate: 0 2px; border-bottom-width: 1px; }

.gfx-btn-blue  { background-color: #1565C0; border-bottom-color: #0D47A1; color: #FFFFFF; }
.gfx-btn-green { background-color: #388E3C; border-bottom-color: #1B5E20; color: #FFFFFF; }
.gfx-btn-red   { background-color: #B71C1C; border-bottom-color: #7F0000; color: #FFFFFF; }
.gfx-btn-blue:hover  { background-color: #1976D2; }
.gfx-btn-green:hover { background-color: #43A047; }
.gfx-btn-red:hover   { background-color: #C62828; }

.gfx-btn--active {
    border-width: 2px;
    border-color: #ECC98A;
    border-bottom-width: 4px;
}

.settings-dropdown {
    height: 40px;
    margin-bottom: 4px;
}
.settings-dropdown .unity-base-popup-field__input {
    background-color: rgba(90, 75, 45, 0.4);
    border-width: 2px;
    border-color: rgba(236, 201, 138, 0.4);
    border-radius: 8px;
    color: #F5EEDB;
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
}

.settings-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}
.settings-slider-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
    font-size: 15px;
    color: #F5EEDB;
    width: 55px;
    min-width: 55px;
}
.settings-slider {
    flex: 1;
    height: 32px;
}
.settings-slider .unity-base-slider__tracker {
    background-color: rgba(90, 75, 45, 0.5);
    border-radius: 4px;
    height: 6px;
}
.settings-slider .unity-base-slider__dragger {
    background-color: #ECC98A;
    border-radius: 10px;
    border-width: 2px;
    border-color: #2C1E0A;
    width: 20px;
    height: 20px;
    top: -7px;
}
