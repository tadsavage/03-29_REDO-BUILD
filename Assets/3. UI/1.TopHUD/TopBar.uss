.topbar-root {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(0, 0, 0, 0.5);
    -unity-text-align: middle-left;
}

.topbar-box {
    background-color: rgba(35, 37, 40, 0.45);
    border-radius: 4px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 32px;
    min-height: 32px;
    line-height: 32px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Font/Kenney%20Future%20Narrow.ttf?fileID=12800000&guid=c4bbc2b151f7a754082a4e6f6d8ed32e&type=3#Kenney Future Narrow");
    white-space: nowrap;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0);
    border-left-color: rgba(204, 153, 77, 0.5);
    border-right-color: rgba(204, 153, 77, 0.5);
    border-top-color: rgba(204, 153, 77, 0.5);
    border-bottom-color: rgba(204, 153, 77, 0.5);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.topbar-money {
    color: rgb(204, 153, 77);
    unity-font-style: bold;
    font-size: 18px;
}

.topbar-hourly {
    color: rgb(204, 153, 77);
    font-size: 18px;
}

.topbar-spent {
    color: rgb(204, 115, 115);
    font-size: 18px;
}

.topbar-time {
    color: rgb(204, 153, 77);
    unity-font-style: bold;
    font-size: 18px;
}
