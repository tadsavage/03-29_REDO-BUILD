/* Container holding both utility action buttons */
.topbar-button-container {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding-left: 8px;
    padding-right: 8px;
    min-width: 140px; /* Gives the text and icons room to sit flat */
}

/* Base button properties with transitions for hover micro-interactions */
.topbar-utility-btn {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 80%;
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 6px;
    padding-right: 8px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    transition: background-color 0.2s ease, border-color 0.2s ease;
}

/* Button Hover State - Matches caramel color highlight details on build window */
.topbar-utility-btn:hover {
    background-color: rgba(212, 135, 77, 0.15);
    border-color: rgba(212, 135, 77, 0.6);
}

/* Active Pressed Feedback State */
.topbar-utility-btn:active {
    background-color: rgba(212, 135, 77, 0.3);
    border-color: rgb(212, 135, 77);
}

/* Standardized dimensions for low poly system icons */
.topbar-utility-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

/* Label element styling layout rules */
.topbar-utility-lbl {
    color: rgb(240, 230, 211);
    font-size: 15px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
}
