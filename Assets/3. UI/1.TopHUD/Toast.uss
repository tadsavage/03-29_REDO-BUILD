.toast-label {
    position: absolute;
    color: rgb(236, 140, 21);
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/Fonts/Kenney%20Future%20Narrow.ttf?fileID=12800000&guid=c4bbc2b151f7a754082a4e6f6d8ed32e&type=3#Kenney Future Narrow");
    text-shadow: 10px 10px 0 rgb(0, 0, 0);
    background-color: rgba(200, 205, 121, 0.61);
    border-left-color: rgba(236, 140, 21, 0.54);
    border-right-color: rgba(236, 140, 21, 0.54);
    border-top-color: rgba(236, 140, 21, 0.54);
    border-bottom-color: rgba(236, 140, 21, 0.54);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}
