<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uxml="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/3.%20UI/1.TopHUD/HUD.uss?fileID=7433441132597879392&amp;guid=f34d0036cbe6d1343a7bb251134182cc&amp;type=3#HUD"/>
    <Style src="project://database/Assets/3.%20UI/1.TopHUD/TopBar.uss?fileID=7433441132597879392&amp;guid=e177c4ab0f3cfdf4c87cdda0512c4745&amp;type=3#TopBar"/>
    <Style src="project://database/Assets/3.%20UI/1.TopHUD/Toast.uss?fileID=7433441132597879392&amp;guid=d60103934d9a3cd4598fe59ca2afd524&amp;type=3#Toast"/>
    <Style src="project://database/Assets/3.%20UI/4.PopupUIs/WorldHoverPopup.uss?fileID=7433441132597879392&amp;guid=e7f4862e76357b3469d9ad92258f0600&amp;type=3#WorldHoverPopup"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" class="hud-root">
        <ui:VisualElement name="TopBar" picking-mode="Ignore" class="topbar-root" style="background-color: rgba(0, 0, 0, 0.7);">
            <ui:VisualElement class="topbar-box">
                <ui:Label name="MoneyLabel" class="topbar-money"/>
            </ui:VisualElement>
            <ui:VisualElement class="topbar-box">
                <ui:Label name="HourlyLabel" class="topbar-hourly"/>
            </ui:VisualElement>
            <ui:VisualElement class="topbar-box">
                <ui:Label name="SpentLabel" class="topbar-spent"/>
            </ui:VisualElement>
            <ui:VisualElement class="topbar-box">
                <ui:Label name="TimeLabel" class="topbar-time"/>
            </ui:VisualElement>
            <ui:VisualElement class="topbar-box">
                <ui:Label name="FPSLabel" text="FPS: 0" class="topbar-time"/>
            </ui:VisualElement>
            <ui:VisualElement class="topbar-box">
                <ui:Label name="StateLabel" text="State: Idle" class="topbar-time"/>
            </ui:VisualElement>
            <ui:VisualElement class="topbar-box">
                <ui:Label name="CellLabel" text="Cell: (0,0)" class="topbar-time"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WorldHoverPopup" picking-mode="Ignore" class="world-hover-popup">
            <ui:Label name="HoverTitle" class="world-hover-title"/>
            <ui:Label name="HoverCost" class="world-hover-cost"/>
            <ui:Label name="HoverHourlyCost" class="world-hover-hourlyCost"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="ToastLabel" text="Toast" picking-mode="Ignore" class="toast-label" style="top: 855px; left: 1390px; font-size: 26px; -unity-text-outline-color: rgba(217, 214, 146, 0.64); -unity-text-align: upper-center;"/>
    <ui:Label name="PreviewCostLabel" text="$1,250" picking-mode="Ignore" class="preview-cost-label" style="flex-direction: column; justify-content: center; align-self: center; font-size: 18px; color: rgba(240, 230, 211, 0.86); -unity-font-style: normal; background-color: rgba(35, 35, 40, 0.78); border-width: 1px; border-radius: 4px; border-color: rgba(221, 204, 143, 0.5); top: 262px; left: 1248px; border-left-color: rgb(239, 131, 49); border-right-color: rgb(239, 131, 49); border-top-color: rgb(239, 131, 49); border-bottom-color: rgb(239, 131, 49); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;"/>
</ui:UXML>
