<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="employee-row" class="employee-row">
        <!-- Status indicator dot -->
        <ui:VisualElement name="status-dot" class="status-dot status-dot-active"/>

        <!-- Name + ID -->
        <ui:VisualElement class="name-column">
            <ui:Label name="row-name" text="Jordan Barnes" class="row-name"/>
            <ui:Label name="row-id" text="WHSE 001" class="row-id"/>
        </ui:VisualElement>

        <!-- Role icon -->
        <ui:VisualElement name="row-role-icon" class="row-role-icon"/>

        <!-- Locate button -->
        <ui:Button name="row-location-btn" text="Locate" class="row-location-btn"/>

        <!-- Task label -->
        <ui:Label name="row-task" text="ToBeImplemented" class="row-task"/>

        <!-- Performance label -->
        <ui:Label name="row-performance" text="-- CPH" class="row-performance"/>

        <!-- Mini stat bars (fatigue + morale) -->
        <ui:VisualElement class="minibars-column">
            <ui:VisualElement class="minibar-row">
                <ui:VisualElement class="minibar-bg">
                    <ui:VisualElement name="row-fatigue-fill" class="minibar-fill fatigue-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="minibar-row">
                <ui:VisualElement class="minibar-bg">
                    <ui:VisualElement name="row-morale-fill" class="minibar-fill morale-fill"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Shift label -->
        <ui:Label name="row-shift" text="Day" class="row-shift"/>
    </ui:VisualElement>
</ui:UXML>
