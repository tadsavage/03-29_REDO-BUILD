.topbar-root {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 56px;
    background-color: rgba(35, 35, 40, 0.95);
    border-bottom-width: 2px;
    border-bottom-color: rgba(236, 201, 138, 0.4);
    padding-left: 20px;
    padding-right: 20px;
    width: 100%;
}

.topbar-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    height: 42px;
    padding-left: 16px;
    padding-right: 16px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.topbar-money,
.topbar-hourly,
.topbar-spent,
.topbar-time,
.topbar-fps,
.topbar-cell {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 17px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.topbar-fps,
.topbar-cell {
    color: rgb(240, 230, 211);
}

.topbar-money {
    color: rgb(160, 255, 200);
}

.topbar-hourly {
    color: rgb(240, 230, 211);
}

.topbar-spent,
.topbar-time {
    color: rgb(240, 230, 211);
}

.topbar-box:hover {
    background-color: rgba(212, 135, 77, 0.12);
    border-color: rgba(212, 135, 77, 0.45);
    transition-duration: 0.25s;
}

.topbar-cell-box {
    min-width: 120px;
    flex-grow: 0.5;
}

.topbar-button-container {
    flex-direction: row;
    justify-content: center;
    min-width: 90px;
    flex-grow: 0.5;
    padding-left: 2px;
    padding-right: 2px;
}

.topbar-icon-button {
    background-color: transparent;
    border-width: 0;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    margin: 0 4px;
    align-items: center;
    justify-content: center;
    flex-direction: row;
}

.topbar-button-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px;
    color: rgb(240, 230, 211);
    margin-left: 6px;
    -unity-text-align: middle-left;
}

.topbar-icon-button:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
}

.topbar-icon {
    width: 20px;
    height: 20px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    -unity-background-image-tint-color: white;
}

.save-icon {
    background-image: url("project://database/Assets/3.%20UI/3.%20BottomHud/BuildBarIcons/Save.png");
}

.load-icon {
    background-image: url("project://database/Assets/3.%20UI/3.%20BottomHud/BuildBarIcons/Load.png");
}

.topbar-mainmenu-btn {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 17px;
    color: rgb(240, 230, 211);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.03);
    transition: background-color 0.2s ease, border-color 0.2s ease;
}

.topbar-mainmenu-btn:hover {
    background-color: rgba(212, 135, 77, 0.15);
    border-color: rgba(212, 135, 77, 0.6);
}

.topbar-mainmenu-btn:active {
    background-color: rgba(212, 135, 77, 0.3);
    border-color: rgb(212, 135, 77);
}
