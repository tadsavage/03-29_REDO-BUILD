:root {
    align-self: auto;
    width: auto;
    height: auto;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.header {
    align-self: center;
    width: 500px;
    height: 200px;
    -unity-background-image-tint-color: rgba(255, 38, 38, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/3.%20UI/kenney_UI/Font/Kenney%20Future.ttf?fileID=12800000&guid=07c5af3b06bdb1042b46f6981eb55afb&type=3#Kenney Future");
    color: rgb(94, 186, 250);
    -unity-text-align: upper-center;
    white-space: nowrap;
    text-shadow: 0.25px 0.25px 1px rgba(0, 0, 0, 0);
    transition-duration: 0.5s;
    align-items: auto;
    justify-content: flex-start;
}

.header:hover {
    scale: 1.05 1.05;
    -unity-background-image-tint-color: rgb(255, 0, 0);
}

.button {
    transition-duration: 0.35s;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: auto;
    scale: 1 1;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    width: 100px;
    height: 90px;
    font-size: 20px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    color: rgb(200, 228, 227);
    -unity-text-align: lower-center;
    -unity-text-outline-width: 0;
    letter-spacing: 0;
    -unity-background-image-tint-color: rgb(225, 234, 234);
    background-image: url("project://database/Assets/3.%20UI/kenney_UI/PNG/Extra/Double/panel_glass_screws.png?fileID=2800000&guid=734d72063a4c4634691f91f815b624a1&type=3#panel_glass_screws");
    background-color: rgb(255, 255, 255);
    -unity-text-outline-color: rgb(138, 225, 234);
    white-space: pre-wrap;
    padding-top: 0;
    margin-top: auto;
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    -unity-slice-type: tiled;
    border-left-color: rgb(208, 239, 238);
    border-right-color: rgb(208, 239, 238);
    border-top-color: rgb(208, 239, 238);
    border-bottom-color: rgb(208, 239, 238);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    transition-timing-function: ease-in-out;
    flex-shrink: 1;
    align-content: auto;
    background-size: 105% 105%;
    padding-bottom: -2px;
}

.button:hover {
    scale: 1.5 1.5 1.5;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    rotate: 0 0 0 0;
    transform-origin: top;
    translate: -20px -35px;
    transition-duration: 0.1s;
    transition-timing-function: ease-in;
}

.thumbnail {
    top: auto;
    width: 60px;
    height: 60px;
    align-self: center;
    background-image: none;
    display: flex;
    background-position-x: center;
    -unity-slice-type: tiled;
    align-items: center;
    align-content: auto;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.97);
}

.label {
    flex-direction: column;
    width: 100px;
    margin-right: 7px;
}

.Image {
    background-image: none;
    align-items: auto;
    align-content: auto;
    margin-top: 20px;
    margin-right: auto;
    margin-bottom: auto;
    margin-left: auto;
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-type: tiled;
    background-color: rgba(255, 255, 255, 0);
    background-size: contain;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.UtilityButtons {
    -unity-font-definition: url("project://database/Assets/1.%20Scripts/1.%20FSM/2.%20UI/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=f2783c05752af154092f8cf505477044&type=3#NotInter-Regular");
    -unity-font-style: normal;
    letter-spacing: -12px;
    color: rgb(85, 239, 234);
    -unity-text-align: middle-center;
    background-color: rgb(0, 0, 0);
    font-size: 28px;
    text-shadow: 3px 3px 0 rgba(0, 0, 0, 0);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(1, 22, 63);
}

utilityThumb {
    top: auto;
    width: 60px;
    height: 60px;
    align-self: center;
    background-image: none;
    display: flex;
    background-position-x: center;
    -unity-slice-type: tiled;
    align-items: center;
    align-content: auto;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.97);
}

.lblObjNames {
    bottom: 24px;
    align-items: auto;
    font-size: 14px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-right: 12px;
    color: rgb(190, 225, 226);
    white-space: nowrap;
}
