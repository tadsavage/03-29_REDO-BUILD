<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/3.%20UI/BottomHud/buildmenu.uss?fileID=7433441132597879392&amp;guid=d8bb7700faa145541bb653373c53d4ec&amp;type=3#buildmenu"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" class="buildmenu-root" style="flex-direction: column; flex-wrap: nowrap; align-items: flex-start; align-self: auto; align-content: auto; height: auto; margin-bottom: 0; background-size: 100% 100%; background-position-x: center; position: absolute; -unity-text-align: upper-left; white-space: nowrap; text-overflow: clip; background-position-y: center;">
        <ui:VisualElement name="BottomBar" picking-mode="Ignore" class="buildmenu-bottom-bar" style="height: 132px; flex-direction: row; align-items: flex-start; justify-content: space-between; align-self: flex-start;">
            <ui:VisualElement name="CategoryRow" class="buildmenu-category-row" style="flex-direction: row; align-items: flex-end; justify-content: flex-start; align-self: center;"/>
            <ui:VisualElement name="UtilityRow" picking-mode="Ignore" class="buildmenu-utility-row" style="border-left-color: rgba(213, 213, 199, 0.6); border-right-color: rgba(213, 213, 199, 0.6); border-top-color: rgba(213, 213, 199, 0.6); border-bottom-color: rgba(213, 213, 199, 0.6); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; display: flex; -unity-text-align: middle-center; background-color: rgba(111, 141, 162, 0.2);"/>
        </ui:VisualElement>
        <ui:VisualElement name="SubmenuContainer" class="buildmenu-submenu buildmenu-submenu-closed"/>
    </ui:VisualElement>
</ui:UXML>
