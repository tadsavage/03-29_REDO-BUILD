<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/3.%20UI/7.ToolsWindow/ToolsWindow.uss?fileID=7433441132597879392&amp;guid=e4e26c3ac8490264d827fefa64523580&amp;type=3#ToolsWindow"/>
    <ui:VisualElement name="tools-overlay" class="tools-overlay">
        <ui:VisualElement name="tools-window" class="tools-window">
            <ui:VisualElement class="tools-tabstrip">
                <ui:Button name="tab-btn-pallet" text="PLT BUILDER" class="tools-tab tools-tab--active"/>
                <ui:Button name="tab-btn-dev" text="DEV CONSOLE" class="tools-tab tools-tab--inactive"/>
            </ui:VisualElement>
            <ui:ScrollView name="tools-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="tools-scroll">
                <ui:VisualElement name="tab-content-pallet" class="tab-content">
                    <ui:VisualElement class="plt-section">
                        <ui:Label text="PRODUCT" class="plt-s-heading"/>
                        <ui:DropdownField name="plt-prefab" label="Case Prefab" class="plt-dropdown"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="plt-section">
                        <ui:Label text="DIMENSIONS" class="plt-s-heading"/>
                        <ui:VisualElement class="plt-row">
                            <ui:Label text="Max Height" picking-mode="Ignore" class="plt-label"/>
                            <ui:TextField name="plt-maxheight" class="plt-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="plt-row">
                            <ui:Label text="Space Between" picking-mode="Ignore" class="plt-label"/>
                            <ui:TextField name="plt-space" class="plt-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="plt-row">
                            <ui:Label text="Vertical Gap" picking-mode="Ignore" class="plt-label"/>
                            <ui:TextField name="plt-gap" class="plt-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="plt-row">
                            <ui:Label text="Crooked Amount" picking-mode="Ignore" class="plt-label"/>
                            <ui:TextField name="plt-crooked" class="plt-field"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="plt-section">
                        <ui:Label text="TI-HI OVERRIDE" class="plt-s-heading"/>
                        <ui:VisualElement class="plt-row">
                            <ui:Label text="Enable Override" picking-mode="Ignore" class="plt-label"/>
                            <ui:Toggle name="plt-override" class="plt-toggle"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="plt-row">
                            <ui:Label text="Ti  (cases / layer)" picking-mode="Ignore" class="plt-label"/>
                            <ui:TextField name="plt-manualt" class="plt-field"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="plt-row">
                            <ui:Label text="Hi  (layers)" picking-mode="Ignore" class="plt-label"/>
                            <ui:TextField name="plt-manualh" class="plt-field"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="plt-build" text="BUILD PALLET" class="plt-build-btn"/>
                </ui:VisualElement>
                <ui:VisualElement name="tab-content-dev" class="tab-content">
                    <ui:VisualElement class="dev-section dev-s-gold">
                        <ui:Label text="ECONOMY" class="dev-s-heading"/>
                        <ui:VisualElement class="dev-pills">
                            <ui:VisualElement class="dev-pill">
                                <ui:Label text="Balance" class="dev-pill-key"/>
                                <ui:Label name="stat-balance" text="$0" class="dev-pill-val"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="dev-pill">
                                <ui:Label text="Hourly" class="dev-pill-key"/>
                                <ui:Label name="stat-hourly" text="$0/hr" class="dev-pill-val"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="dev-pill">
                                <ui:Label text="Today" class="dev-pill-key"/>
                                <ui:Label name="stat-spent" text="$0" class="dev-pill-val"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-actions">
                            <ui:Button name="btn-add-1k" text="+$1K" class="dev-btn dev-btn-gold"/>
                            <ui:Button name="btn-add-10k" text="+$10K" class="dev-btn dev-btn-gold"/>
                            <ui:Button name="btn-add-100k" text="+$100K" class="dev-btn dev-btn-gold"/>
                            <ui:Button name="btn-zero" text="ZERO" class="dev-btn dev-btn-danger"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="dev-section dev-s-amber">
                        <ui:Label text="TIME" class="dev-s-heading"/>
                        <ui:VisualElement class="dev-pills">
                            <ui:VisualElement class="dev-pill dev-pill-wide">
                                <ui:Label text="Sim Time" class="dev-pill-key"/>
                                <ui:Label name="stat-time" text="Day 1  08:00" class="dev-pill-val"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="dev-pill">
                                <ui:Label text="Speed" class="dev-pill-key"/>
                                <ui:Label name="stat-speed" text="1×" class="dev-pill-val"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-actions">
                            <ui:Button name="btn-pause" text="⏸" class="dev-btn dev-btn-amber"/>
                            <ui:Button name="btn-1x" text="1×" class="dev-btn dev-btn-amber"/>
                            <ui:Button name="btn-2x" text="2×" class="dev-btn dev-btn-amber"/>
                            <ui:Button name="btn-5x" text="5×" class="dev-btn dev-btn-amber"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="dev-section dev-s-teal">
                        <ui:Label text="WORLD" class="dev-s-heading"/>
                        <ui:VisualElement class="dev-pills">
                            <ui:VisualElement class="dev-pill">
                                <ui:Label text="Objects" class="dev-pill-key"/>
                                <ui:Label name="stat-objects" text="0" class="dev-pill-val"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="dev-pill dev-pill-wide">
                                <ui:Label text="Undo / Redo" class="dev-pill-key"/>
                                <ui:Label name="stat-undo" text="0 / 0" class="dev-pill-val"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-actions">
                            <ui:Button name="btn-rebuild" text="REBUILD GRID" class="dev-btn dev-btn-teal"/>
                            <ui:Button name="btn-clear" text="CLEAR ALL" class="dev-btn dev-btn-danger"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="dev-section dev-s-rose">
                        <ui:Label text="FSM" class="dev-s-heading"/>
                        <ui:VisualElement class="dev-pills">
                            <ui:VisualElement class="dev-pill dev-pill-wide">
                                <ui:Label text="Current State" class="dev-pill-key"/>
                                <ui:Label name="stat-state" text="—" class="dev-pill-val"/>
                            </ui:VisualElement>
                            <ui:VisualElement class="dev-pill">
                                <ui:Label text="Stack" class="dev-pill-key"/>
                                <ui:Label name="stat-stack" text="0" class="dev-pill-val"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement name="tools-titlebar" class="tools-titlebar">
                <ui:Label text="⚙  TOOLS" class="tools-title"/>
                <ui:Button name="tools-close" text="✕" class="tools-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
