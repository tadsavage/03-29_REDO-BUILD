.hud-root {
    position: absolute;
    top: 0px;
    left: 0px;
    right: 0px;

    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;

    padding: 0px;
    margin: 0px;

    /* Transparent container so child elements (TopBar + CostLabel) float cleanly */
    background-color: rgba(0, 0, 0, 0.0);
}

/* Cost preview label */
.preview-cost-label {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);

    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;

    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;

    color: white;
    unity-font-style: bold;
    font-size: 14px;

    /* Subtle glow for clarity over grid */
    text-shadow: 0px 0px 4px rgba(0, 0, 0, 0.8);

    /* Hidden by default — your C# toggles visibility */
    display: none;
}
