/* =====================================================
   DEV CONSOLE — Two Point Hospital aesthetic
   Toggle: backtick (`) or the ⚙ DEV pill button
   ===================================================== */

/* Shared font aliases */
#dev-overlay Label,
#dev-overlay Button {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
}

/* ── OVERLAY ROOT ──────────────────────────────────── */
.dev-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    picking-mode: ignore;
}

/* ── TOGGLE PILL ───────────────────────────────────── */
.dev-toggle {
    position: absolute;
    top: 56px;
    right: 10px;
    width: 80px;
    height: 30px;
    border-radius: 15px;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: #B5004E;
    background-color: #FF4081;
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 13px;
    -unity-text-letter-spacing: 1px;
    -unity-text-align: middle-center;
    picking-mode: position;
}
.dev-toggle:hover  { background-color: #FF6DA0; }
.dev-toggle:active {
    background-color: #C2185B;
    border-bottom-width: 1px;
    margin-top: 2px;
}

/* ── MAIN PANEL ────────────────────────────────────── */
.dev-panel {
    position: absolute;
    top: 94px;
    right: 10px;
    width: 420px;
    background-color: #0D0D22;
    border-radius: 14px;
    border-width: 2px;
    border-color: #252548;
    overflow: hidden;
}

/* ── HEADER ────────────────────────────────────────── */
.dev-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #17173A;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 14px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: #2A2A5A;
}

.dev-title {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 17px;
    -unity-text-letter-spacing: 3px;
    color: #EEEEFF;
}

.dev-close {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: #B5004E;
    background-color: #FF4081;
    color: #FFFFFF;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 14px;
    -unity-text-align: middle-center;
}
.dev-close:hover  { background-color: #FF6DA0; }
.dev-close:active {
    background-color: #C2185B;
    border-bottom-width: 1px;
    margin-top: 2px;
}

/* ── SCROLL BODY ───────────────────────────────────── */
.dev-body {
    max-height: 600px;
}

.dev-body > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical {
    width: 6px;
    background-color: transparent;
    margin: 4px 2px;
}
.dev-body .unity-base-slider__dragger {
    background-color: #3A3A6A;
    border-radius: 3px;
    border-width: 0;
}
.dev-body .unity-scroller__low-button,
.dev-body .unity-scroller__high-button {
    display: none;
    height: 0;
    width: 0;
}

/* ── SECTION CARD ──────────────────────────────────── */
.dev-section {
    margin-top: 8px;
    margin-bottom: 0;
    margin-left: 8px;
    margin-right: 8px;
    border-radius: 10px;
    background-color: #131330;
    border-left-width: 4px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
}
.dev-section:last-child {
    margin-bottom: 8px;
}

.dev-s-cyan  { border-left-color: #00E5FF; }
.dev-s-amber { border-left-color: #FFD740; }
.dev-s-green { border-left-color: #00E676; }
.dev-s-pink  { border-left-color: #FF4081; }

/* ── SECTION HEADING ───────────────────────────────── */
.dev-s-heading {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 10px;
    -unity-text-letter-spacing: 3px;
    margin-bottom: 8px;
}
.dev-s-cyan  > .dev-s-heading { color: #00AABB; }
.dev-s-amber > .dev-s-heading { color: #BB9900; }
.dev-s-green > .dev-s-heading { color: #00AA55; }
.dev-s-pink  > .dev-s-heading { color: #CC3366; }

/* ── STAT PILLS ────────────────────────────────────── */
.dev-pills {
    flex-direction: row;
    margin-bottom: 8px;
}

.dev-pill {
    flex: 1;
    background-color: #1C1C40;
    border-radius: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 6px;
    min-width: 0;
}
.dev-pill:last-child { margin-right: 0; }
.dev-pill-wide { flex: 1.6; }

.dev-pill-key {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Regular.ttf?fileID=12800000&guid=65659553c3e2aec4fa1368693dea6c68&type=3#Fredoka-Regular");
    font-size: 9px;
    -unity-text-letter-spacing: 1px;
    color: #8888AA;
    margin-bottom: 2px;
}

.dev-pill-val {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 16px;
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

.dev-cyan  { color: #00E5FF; }
.dev-amber { color: #FFD740; }
.dev-green { color: #00E676; }
.dev-pink  { color: #FF4081; }

/* ── ACTION BUTTONS ────────────────────────────────── */
.dev-actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.dev-btn {
    height: 30px;
    border-radius: 8px;
    border-width: 0;
    border-bottom-width: 3px;
    margin-right: 6px;
    margin-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 12px;
    -unity-text-letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: #0A0A20;
}
.dev-btn:last-child { margin-right: 0; }

.dev-btn-cyan   { background-color: #00E5FF; border-bottom-color: #0099AA; }
.dev-btn-amber  { background-color: #FFD740; border-bottom-color: #AA8800; }
.dev-btn-green  { background-color: #00E676; border-bottom-color: #009944; }
.dev-btn-danger { background-color: #FF5252; border-bottom-color: #AA0000; color: #FFFFFF; }

.dev-btn-cyan:hover   { background-color: #44EEFF; }
.dev-btn-amber:hover  { background-color: #FFE066; }
.dev-btn-green:hover  { background-color: #44EE8C; }
.dev-btn-danger:hover { background-color: #FF7070; }

.dev-btn-cyan:active   { background-color: #00B8CC; border-bottom-width: 1px; margin-top: 2px; }
.dev-btn-amber:active  { background-color: #CCAA00; border-bottom-width: 1px; margin-top: 2px; }
.dev-btn-green:active  { background-color: #00BB55; border-bottom-width: 1px; margin-top: 2px; }
.dev-btn-danger:active { background-color: #CC2020; border-bottom-width: 1px; margin-top: 2px; }
