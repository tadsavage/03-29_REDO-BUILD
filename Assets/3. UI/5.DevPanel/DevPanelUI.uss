/* =====================================================
   DEV CONSOLE
   Toggle: backtick (`)
   ===================================================== */

#dev-overlay Label,
#dev-overlay Button {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&guid=189cc47193d14cf48980be934208aa1c&type=3#Fredoka-Medium");
}

/* ── OVERLAY ROOT ──────────────────────────────────── */
.dev-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    picking-mode: ignore;
}

/* ── MAIN PANEL ────────────────────────────────────── */
.dev-panel {
    position: absolute;
    top: 50px;
    left: 12px;
    width: 380px;
    background-color: rgba(10, 10, 28, 0.97);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(80, 80, 140, 0.6);
    overflow: hidden;
}

/* ── HEADER ────────────────────────────────────────── */
.dev-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(20, 20, 50, 1);
    padding: 10px 10px 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 80, 140, 0.5);
}

.dev-title {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 13px;
    -unity-text-letter-spacing: 3px;
    color: rgba(200, 200, 255, 0.9);
}

.dev-close {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(180, 0, 60, 0.8);
    background-color: #FF4081;
    color: #FFFFFF;
    font-size: 13px;
    -unity-text-align: middle-center;
    padding: 0;
}
.dev-close:hover  { background-color: #FF6DA0; }
.dev-close:active { background-color: #C2185B; border-bottom-width: 1px; translate: 0 1px; }

/* ── SCROLL BODY ───────────────────────────────────── */
.dev-body {
    max-height: 540px;
    padding-bottom: 4px;
}

.dev-body > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical {
    width: 4px;
    background-color: transparent;
    margin: 4px 2px;
}
.dev-body .unity-base-slider__dragger {
    background-color: rgba(80, 80, 160, 0.6);
    border-radius: 2px;
    border-width: 0;
}
.dev-body .unity-scroller__low-button,
.dev-body .unity-scroller__high-button {
    display: none;
    height: 0;
    width: 0;
}

/* ── SECTION CARD ──────────────────────────────────── */
.dev-section {
    margin: 6px 8px 0 8px;
    border-radius: 8px;
    background-color: rgba(18, 18, 42, 1);
    border-left-width: 3px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    padding: 10px 12px 10px 12px;
}

.dev-s-cyan  { border-left-color: #00D4EE; }
.dev-s-amber { border-left-color: #FFD740; }
.dev-s-green { border-left-color: #00E676; }
.dev-s-pink  { border-left-color: #FF4081; }

/* ── SECTION HEADING ───────────────────────────────── */
.dev-s-heading {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 9px;
    -unity-text-letter-spacing: 3px;
    margin-bottom: 8px;
}
.dev-s-cyan  > .dev-s-heading { color: rgba(0, 180, 210, 0.7); }
.dev-s-amber > .dev-s-heading { color: rgba(200, 160, 0, 0.7); }
.dev-s-green > .dev-s-heading { color: rgba(0, 180, 100, 0.7); }
.dev-s-pink  > .dev-s-heading { color: rgba(200, 50, 100, 0.7); }

/* ── STAT PILLS ────────────────────────────────────── */
.dev-pills {
    flex-direction: row;
    margin-bottom: 8px;
}

.dev-pill {
    flex: 1;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    padding: 6px 8px;
    margin-right: 5px;
    min-width: 0;
}
.dev-pill-wide { flex: 1.6; }

.dev-pill-key {
    font-size: 8px;
    -unity-text-letter-spacing: 1px;
    color: rgba(150, 150, 190, 0.7);
    margin-bottom: 3px;
}

.dev-pill-val {
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 15px;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
    white-space: nowrap;
}

.dev-cyan  { color: #00D4EE; }
.dev-amber { color: #FFD740; }
.dev-green { color: #00E676; }
.dev-pink  { color: #FF4081; }

/* ── ACTION BUTTONS ────────────────────────────────── */
.dev-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.dev-btn {
    height: 28px;
    border-radius: 6px;
    border-width: 0;
    border-bottom-width: 2px;
    margin-right: 5px;
    margin-bottom: 0;
    padding: 0 11px;
    -unity-font-definition: url("project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-SemiBold.ttf?fileID=12800000&guid=3a2aea0e0a0a3bd4a864ce106055c4c2&type=3#Fredoka-SemiBold");
    font-size: 11px;
    -unity-text-letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgba(10, 10, 30, 0.95);
}

.dev-btn-cyan   { background-color: #00D4EE; border-bottom-color: #008899; }
.dev-btn-amber  { background-color: #FFD740; border-bottom-color: #AA8800; }
.dev-btn-green  { background-color: #00E676; border-bottom-color: #008844; }
.dev-btn-danger { background-color: #FF5252; border-bottom-color: #AA1111; color: #FFFFFF; }

.dev-btn-cyan:hover   { background-color: #33DDEE; }
.dev-btn-amber:hover  { background-color: #FFE060; }
.dev-btn-green:hover  { background-color: #33EE88; }
.dev-btn-danger:hover { background-color: #FF7070; }

.dev-btn-cyan:active   { background-color: #009DB8; border-bottom-width: 1px; translate: 0 1px; }
.dev-btn-amber:active  { background-color: #CCAA00; border-bottom-width: 1px; translate: 0 1px; }
.dev-btn-green:active  { background-color: #00BB55; border-bottom-width: 1px; translate: 0 1px; }
.dev-btn-danger:active { background-color: #CC2020; border-bottom-width: 1px; translate: 0 1px; }
