<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/3.%20UI/5.DevPanel/DevPanelUI.uss?fileID=7433441132597879392&amp;guid=832bf69342d329245b63c31a4e8fcb09&amp;type=3#DevPanelUI"/>
    <ui:VisualElement name="dev-overlay" class="dev-overlay">
        <ui:VisualElement name="dev-panel" class="dev-panel">
            <ui:ScrollView name="dev-body" horizontal-scroller-visibility="Hidden" class="dev-body">
                <ui:VisualElement class="dev-section dev-s-cyan">
                    <ui:Label text="ECONOMY" class="dev-s-heading"/>
                    <ui:VisualElement class="dev-pills">
                        <ui:VisualElement class="dev-pill">
                            <ui:Label text="Balance" class="dev-pill-key"/>
                            <ui:Label name="stat-balance" text="$0" class="dev-pill-val dev-cyan"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-pill">
                            <ui:Label text="Hourly" class="dev-pill-key"/>
                            <ui:Label name="stat-hourly" text="$0/hr" class="dev-pill-val dev-cyan"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-pill">
                            <ui:Label text="Spent Today" class="dev-pill-key"/>
                            <ui:Label name="stat-spent" text="$0" class="dev-pill-val dev-cyan"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="dev-actions">
                        <ui:Button name="btn-add-1k" text="+$1K" class="dev-btn dev-btn-cyan"/>
                        <ui:Button name="btn-add-10k" text="+$10K" class="dev-btn dev-btn-cyan"/>
                        <ui:Button name="btn-add-100k" text="+$100K" class="dev-btn dev-btn-cyan"/>
                        <ui:Button name="btn-zero" text="ZERO" class="dev-btn dev-btn-danger"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="dev-section dev-s-amber">
                    <ui:Label text="TIME" class="dev-s-heading"/>
                    <ui:VisualElement class="dev-pills">
                        <ui:VisualElement class="dev-pill dev-pill-wide">
                            <ui:Label text="Sim Time" class="dev-pill-key"/>
                            <ui:Label name="stat-time" text="Day 1 — 08:00" class="dev-pill-val dev-amber"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-pill">
                            <ui:Label text="Speed" class="dev-pill-key"/>
                            <ui:Label name="stat-speed" text="1×" class="dev-pill-val dev-amber"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="dev-actions">
                        <ui:Button name="btn-pause" text="⏸" class="dev-btn dev-btn-amber"/>
                        <ui:Button name="btn-1x" text="1×" class="dev-btn dev-btn-amber"/>
                        <ui:Button name="btn-2x" text="2×" class="dev-btn dev-btn-amber"/>
                        <ui:Button name="btn-5x" text="5×" class="dev-btn dev-btn-amber"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="dev-section dev-s-green">
                    <ui:Label text="WORLD" class="dev-s-heading"/>
                    <ui:VisualElement class="dev-pills">
                        <ui:VisualElement class="dev-pill">
                            <ui:Label text="Objects" class="dev-pill-key"/>
                            <ui:Label name="stat-objects" text="0" class="dev-pill-val dev-green"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-pill dev-pill-wide">
                            <ui:Label text="Undo / Redo" class="dev-pill-key"/>
                            <ui:Label name="stat-undo" text="0 / 0" class="dev-pill-val dev-green"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="dev-actions">
                        <ui:Button name="btn-rebuild" text="REBUILD GRID" class="dev-btn dev-btn-green"/>
                        <ui:Button name="btn-clear" text="CLEAR ALL" class="dev-btn dev-btn-danger"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="dev-section dev-s-pink">
                    <ui:Label text="FSM" class="dev-s-heading"/>
                    <ui:VisualElement class="dev-pills">
                        <ui:VisualElement class="dev-pill dev-pill-wide">
                            <ui:Label text="Current State" class="dev-pill-key"/>
                            <ui:Label name="stat-state" text="—" class="dev-pill-val dev-pink"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="dev-pill">
                            <ui:Label text="Stack Depth" class="dev-pill-key"/>
                            <ui:Label name="stat-stack" text="0" class="dev-pill-val dev-pink"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement name="dev-header" class="dev-header">
                <ui:Label text="DEV CONSOLE" class="dev-title"/>
                <ui:Button name="close-btn" text="✕" class="dev-close"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
