.buildmenu-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

/* PALIA THEME: Deep purple-charcoal base panel with clean gold top accent border */
.buildmenu-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background-color: #2D2B3A;
    border-top-width: 2px;
    border-top-color: #ECC98A;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    overflow: visible; /* ALLOWS HOVER TOOLTIPS TO DISPLAY OUTSIDE THE BAR BOUNDS */
}

.buildmenu-category-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
}

.buildmenu-utility-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
    /* Explicitly prevent your utilities row from over-expanding */
    max-width: 520px !important; 
}

/* PALIA THEME: Category buttons use a subtle dark container shade */
.buildmenu-category-button {
    width: 120px;
    height: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(90, 85, 110, 0.15);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(236, 201, 138, 0.2);
    padding: 4px;
    margin: 4px;
    opacity: 1;
}

/* PALIA THEME: Hover glows with light gold borders */
.buildmenu-category-button:hover {
    background-color: rgba(236, 201, 138, 0.1);
    border-color: #ECC98A;
    opacity: 0.95;
}

/* PALIA THEME: Selected buttons highlight in solid gold with deep text contrast */
.buildmenu-category-button.selected {
    background-color: #ECC98A;
    border-color: #F5EEDB;
    opacity: 1;
}

.buildmenu-category-icon {
    width: 96px;
    height: 88px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

/* PALIA THEME: Text labels use soft off-white parchment tones */
.buildmenu-category-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 16px;
    -unity-text-letter-spacing: -1px;
    -unity-font-style: normal;
    color: #F5EEDB;
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-utility-button {
    width: 84px;
    height: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #3E3B4F;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(236, 201, 138, 0.4);
    padding: 4px;
    margin: 4px;
    opacity: 1;
}

.buildmenu-utility-button:hover {
    background-color: rgba(236, 201, 138, 0.1);
    border-color: #ECC98A;
    opacity: 0.95;
}

.buildmenu-utility-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-bottom: 4px;
}

.buildmenu-utility-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 11px;
    -unity-text-letter-spacing: -1px;
    -unity-font-style: bold;
    color: #F5EEDB;
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-submenu {
    position: absolute;
    left: 16px;
    bottom: 128px;
    opacity: 0;
    display: none;
}

.buildmenu-submenu-open {
    opacity: 1;
    display: flex;
}

.buildmenu-submenu-closed {
    opacity: 0;
    display: none;
}

/* FIXED MERGE: Submenu dropdown uses the same dark backdrop with an elegant gold border framing, right padding, and overflow hidden */
.buildmenu-submenu-root {
    background-color: #2D2B3A;
    border-radius: 6px;
    border-width: 2px;
    border-color: #ECC98A;
    padding: 6px;
    padding-right: 8px; 
    max-height: 320px;
    overflow: hidden; 
}

.buildmenu-submenu-scroll {
    flex-grow: 1;
}

/* PALIA THEME: Item buttons use a slightly lighter muted gray-purple panel tint */
.buildmenu-item-button {
    width: 260px;
    height: 64px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 6px;
    margin-bottom: 6px;
    background-color: #3E3B4F;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(236, 201, 138, 0.2);
    opacity: 1;
}

/* PALIA THEME: Item cards highlight cleanly on hover with gold borders */
.buildmenu-item-button:hover {
    background-color: rgba(236, 201, 138, 0.12);
    border-color: #ECC98A;
    opacity: 1;
}

.buildmenu-item-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 10px;
}

.buildmenu-item-text {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.buildmenu-item-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 15px;
    -unity-text-letter-spacing: 0px;
    color: #F5EEDB;
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

/* PALIA THEME: Item costs match the soft sand/gold utility elements */
.buildmenu-item-cost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px;
    -unity-text-letter-spacing: 0px;
    color: #ECC98A;
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

/* ==========================================
   PIXEL-PERFECT SCROLLBAR GAP OVERRIDES
   ========================================== */

.buildmenu-submenu-scroll .unity-scroller {
    width: 14px;
    background-color: transparent;
    margin-top: 4px;     
    margin-bottom: 4px;  
    margin-right: 6px;   
}

.buildmenu-submenu-scroll .unity-scroller__slider {
    background-color: #3E3B4F; 
    border-radius: 4px; 
    margin: 0;
    border-width: 0;
}

.buildmenu-submenu-scroll .unity-scroller__thumb {
    background-color: #ECC98A; 
    border-radius: 4px;
    border-width: 0;
}

.buildmenu-submenu-scroll .unity-scroller__thumb:hover {
    background-color: #F5EEDB; 
}

.buildmenu-submenu-scroll .unity-scroller__low-button, 
.buildmenu-submenu-scroll .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    height: 0;
    width: 0;
    margin: 0;
    padding: 0;
}

/* THE SELECTION DISPLAY BOX CONTAINER */
.buildmenu-stationed-popup {
    flex-grow: 1;
    max-width: 400px;
    height: auto !important;     
    min-height: 104px !important; 
    margin: 8px 16px;
    padding: 6px 12px !important; 
    background-color: rgba(90, 85, 110, 0.15);
    border-width: 1px;
    border-color: rgba(236, 201, 138, 0.2);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}


/* THE ITEM TITLE TEXT (Added explicit target handling for #HoverTitle) */
.world-hover-title, #HoverTitle, .buildmenu-stationed-popup #HoverTitle {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular") !important;
    font-size: 22px !important; /* Forces text up to large display metric */
    height: auto !important;       
    max-height: none !important;   
    color: #FFFFFF !important;
    margin-top: 0 !important;
    margin-bottom: 2px !important;
    -unity-text-align: middle-center !important;
}

/* FORCE THE LOWER ROW LABELS TO MATCH THE COST FORMAT EXACTLY */
.buildmenu-stationed-popup Label, #HoverCost, #HoverHourlyCost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular") !important;
    font-size: 12px !important;
    height: auto !important;       
    max-height: none !important;
    color: #ECC98A !important;
    margin-top: 1px !important;
    margin-bottom: 1px !important;
    -unity-text-align: middle-center !important;
}

/* EXCLUDE THE TITLE REGARDLESS OF SELECTOR TYPE SO IT ALWAYS REMAINS WHITE */
.buildmenu-stationed-popup #HoverTitle, .buildmenu-stationed-popup .world-hover-title {
    color: #FFFFFF !important;
}
/* ==========================================
   DYNAMIC CUSTOM WALL ICON STYLE OVERRIDES
   ========================================== */

.wall-lower-icon {
    width: 90px !important;
    height: 90px !important;
    align-self: center;
}

.wall-raise-icon {
    width: 90px !important;
    height: 90px !important;
    align-self: center;
}
