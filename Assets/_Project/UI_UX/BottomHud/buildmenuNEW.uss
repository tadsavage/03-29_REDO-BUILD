.buildmenu-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

/* Retheme 2026-06-14: matched to the Employee Roster / Hiring Board palette.
   Back bar = rgba(20,28,38,0.82) + blue #5C9BC4 top border; button/card faces =
   rgba(34,44,56,0.55) + subtle white borders, blue hovers; selected = blue fill.
   Layout, sizes and fonts are unchanged. */
.buildmenu-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background-color: rgba(20, 28, 38, 0.82);
    border-top-width: 2px;
    border-top-color: rgba(92, 155, 196, 0.6);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    overflow: visible; /* ALLOWS HOVER TOOLTIPS TO DISPLAY OUTSIDE THE BAR BOUNDS */
}

.buildmenu-category-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
}

.buildmenu-utility-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
    /* Explicitly prevent your utilities row from over-expanding */
    max-width: 520px !important;
}

/* Category buttons — card face */
.buildmenu-category-button {
    width: 120px;
    height: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(34, 44, 56, 0.55);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    opacity: 1;
}

/* Hover — blue card highlight */
.buildmenu-category-button:hover {
    background-color: rgba(46, 60, 76, 0.65);
    border-color: rgba(92, 155, 196, 0.35);
    opacity: 0.95;
}

/* Selected — blue fill */
.buildmenu-category-button.selected {
    background-color: rgba(76, 144, 192, 0.55);
    border-color: rgb(92, 155, 196);
    opacity: 1;
}

.buildmenu-category-icon {
    width: 96px;
    height: 88px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.buildmenu-category-label {
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-RegularSDF.asset?fileID=11400000&guid=d86e933e6ca983a45ad912f7d7fa9882&type=2#LilitaOne-Regular");
    font-size: 16px;
    -unity-text-letter-spacing: -1px;
    -unity-font-style: normal;
    color: #96BEDC;
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-utility-button {
    width: 84px;
    height: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(34, 44, 56, 0.55);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    opacity: 1;
}

.buildmenu-utility-button:hover {
    background-color: rgba(46, 60, 76, 0.65);
    border-color: rgba(92, 155, 196, 0.35);
    opacity: 0.95;
}

.buildmenu-utility-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-bottom: 4px;
    -unity-background-image-tint-color: #96BEDC;
}

.buildmenu-utility-label {
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-RegularSDF.asset?fileID=11400000&guid=d86e933e6ca983a45ad912f7d7fa9882&type=2#LilitaOne-Regular");
    font-size: 11px;
    -unity-text-letter-spacing: -1px;
    -unity-font-style: bold;
    color: #96BEDC;
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-submenu {
    position: absolute;
    left: 16px;
    bottom: 128px;
    opacity: 0;
    display: none;
}

.buildmenu-submenu-open {
    opacity: 1;
    display: flex;
}

.buildmenu-submenu-closed {
    opacity: 0;
    display: none;
}

/* Submenu dropdown — back panel with blue framing */
.buildmenu-submenu-root {
    background-color: rgba(20, 28, 38, 0.92);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(92, 155, 196);
    padding: 6px;
    padding-right: 8px;
    max-height: 320px;
    overflow: hidden;
}

.buildmenu-submenu-scroll {
    flex-grow: 1;
}

/* Item buttons — card face */
.buildmenu-item-button {
    width: 260px;
    height: 64px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 6px;
    margin-bottom: 6px;
    background-color: rgba(34, 44, 56, 0.55);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    opacity: 1;
}

/* Item cards — blue hover highlight */
.buildmenu-item-button:hover {
    background-color: rgba(46, 60, 76, 0.65);
    border-color: rgba(92, 155, 196, 0.35);
    opacity: 1;
}

.buildmenu-item-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 10px;
}

.buildmenu-item-text {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.buildmenu-item-name {
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-RegularSDF.asset?fileID=11400000&guid=d86e933e6ca983a45ad912f7d7fa9882&type=2#LilitaOne-Regular");
    font-size: 15px;
    -unity-text-letter-spacing: 0px;
    color: #96BEDC;
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

/* Item costs — kept as the soft gold accent */
.buildmenu-item-cost {
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-RegularSDF.asset?fileID=11400000&guid=d86e933e6ca983a45ad912f7d7fa9882&type=2#LilitaOne-Regular");
    font-size: 14px;
    -unity-text-letter-spacing: 0px;
    color: #ECC98A;
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

/* ==========================================
   PIXEL-PERFECT SCROLLBAR GAP OVERRIDES
   ========================================== */

.buildmenu-submenu-scroll .unity-scroller {
    width: 14px;
    background-color: transparent;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-right: 6px;
}

.buildmenu-submenu-scroll .unity-scroller__slider {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    margin: 0;
    border-width: 0;
}

.buildmenu-submenu-scroll .unity-scroller__thumb {
    background-color: rgba(92, 155, 196, 0.45);
    border-radius: 4px;
    border-width: 0;
}

.buildmenu-submenu-scroll .unity-scroller__thumb:hover {
    background-color: rgba(92, 155, 196, 0.7);
}

.buildmenu-submenu-scroll .unity-scroller__low-button,
.buildmenu-submenu-scroll .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    height: 0;
    width: 0;
    margin: 0;
    padding: 0;
}

/* THE SELECTION DISPLAY BOX CONTAINER — card face */
.buildmenu-stationed-popup {
    flex-grow: 1;
    max-width: 400px;
    height: auto !important;
    min-height: 104px !important;
    margin: 8px 16px;
    padding: 6px 12px !important;
    background-color: rgba(34, 44, 56, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}


/* THE ITEM TITLE TEXT — scoped to stationed popup only, floating popup uses WorldHoverPopup.uss */
.buildmenu-stationed-popup .world-hover-title, .buildmenu-stationed-popup #HoverTitle {
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-RegularSDF.asset?fileID=11400000&guid=d86e933e6ca983a45ad912f7d7fa9882&type=2#LilitaOne-Regular") !important;
    font-size: 22px !important;
    height: auto !important;
    max-height: none !important;
    color: #FFFFFF !important;
    margin-top: 0 !important;
    margin-bottom: 2px !important;
    -unity-text-align: middle-center !important;
}

/* FORCE THE LOWER ROW LABELS — scoped to stationed popup only */
.buildmenu-stationed-popup Label, .buildmenu-stationed-popup #HoverCost, .buildmenu-stationed-popup #HoverHourlyCost {
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-RegularSDF.asset?fileID=11400000&guid=d86e933e6ca983a45ad912f7d7fa9882&type=2#LilitaOne-Regular") !important;
    font-size: 12px !important;
    height: auto !important;
    max-height: none !important;
    color: #ECC98A !important;
    margin-top: 1px !important;
    margin-bottom: 1px !important;
    -unity-text-align: middle-center !important;
}

/* EXCLUDE THE TITLE SO IT ALWAYS REMAINS WHITE */
.buildmenu-stationed-popup #HoverTitle, .buildmenu-stationed-popup .world-hover-title {
    color: #FFFFFF !important;
}
/* ==========================================
   DYNAMIC CUSTOM WALL ICON STYLE OVERRIDES
   ========================================== */

.wall-lower-icon {
    width: 90px !important;
    height: 90px !important;
    align-self: center;
    -unity-background-image-tint-color: #96BEDC;
}

.wall-raise-icon {
    width: 90px !important;
    height: 90px !important;
    align-self: center;
    -unity-background-image-tint-color: #96BEDC;
}
