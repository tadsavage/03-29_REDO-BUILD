/* ── TOAST NOTIFICATION ─────────────────────────────────
   Positioned programmatically to Screen.width/2, Screen.height/2
   sortingOrder=100 keeps it above all other panels
   ───────────────────────────────────────────────────────── */

.toast-label {
    position: absolute;
    width: auto;
    max-width: 1860px;
    color: #CFE2F0;
    font-size: 36px;
    -unity-font-definition: url("project://database/Assets/_Project/Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-RegularSDF.asset?fileID=11400000&guid=d86e933e6ca983a45ad912f7d7fa9882&type=2#LilitaOne-Regular");
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.85);
    background-color: rgba(18, 26, 36, 0.97);
    border-color: #5C9BC4;
    border-width: 3px;
    border-radius: 15px;
    padding-left: 42px;
    padding-right: 42px;
    padding-top: 18px;
    padding-bottom: 18px;
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}
