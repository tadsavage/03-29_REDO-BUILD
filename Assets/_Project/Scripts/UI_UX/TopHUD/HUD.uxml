<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uxml="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/3.%20UI/2.%20TopHUD/HUD.uss?fileID=7433441132597879392&amp;guid=f34d0036cbe6d1343a7bb251134182cc&amp;type=3#HUD"/>
    <Style src="project://database/Assets/3.%20UI/2.%20TopHUD/TopBar.uss?fileID=7433441132597879392&amp;guid=e177c4ab0f3cfdf4c87cdda0512c4745&amp;type=3#TopBar"/>
    <Style src="project://database/Assets/3.%20UI/2.%20TopHUD/Toast.uss?fileID=7433441132597879392&amp;guid=d60103934d9a3cd4598fe59ca2afd524&amp;type=3#Toast"/>
    <Style src="project://database/Assets/3.%20UI/6.%20PopupUIs/WorldHoverPopup.uss?fileID=7433441132597879392&amp;guid=e7f4862e76357b3469d9ad92258f0600&amp;type=3#WorldHoverPopup"/>
    <Style src="project://database/Assets/_Project/Scripts/UI_UX/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=ce5e780b1ce92844eaa156c6246ff9c5&amp;type=3#MainMenu"/>
    
    <ui:VisualElement name="Root" picking-mode="Ignore" class="hud-root">
        <ui:VisualElement name="TopBar" picking-mode="Position" class="topbar-root">
            <ui:VisualElement class="topbar-box"><ui:Label name="MoneyLabel" class="topbar-money"/></ui:VisualElement>
            <ui:VisualElement class="topbar-box"><ui:Label name="HourlyLabel" class="topbar-hourly"/></ui:VisualElement>
            <ui:VisualElement class="topbar-box"><ui:Label name="SpentLabel" class="topbar-spent"/></ui:VisualElement>
            <ui:VisualElement class="topbar-box"><ui:Label name="TimeLabel" class="topbar-time"/></ui:VisualElement>
            <ui:VisualElement class="topbar-box"><ui:Label name="CellLabel" class="topbar-cell"/></ui:VisualElement>
            <ui:VisualElement name="SpeedBox" class="topbar-box">
                <ui:VisualElement name="SpeedControl" class="topbar-speed">
                    <ui:Button name="SpeedPause" class="topbar-speed-btn" text="II" />
                    <ui:Button name="SpeedQuarter" class="topbar-speed-btn" text="1/4" />
                    <ui:Button name="SpeedHalf" class="topbar-speed-btn" text="1/2" />
                    <ui:Button name="Speed1x" class="topbar-speed-btn" text="&gt;" />
                    <ui:Button name="Speed2x" class="topbar-speed-btn" text="&gt;&gt;" />
                    <ui:Button name="Speed3x" class="topbar-speed-btn" text="&gt;&gt;&gt;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:Button name="MainMenuButton" text="MENU (ESC)" class="topbar-box topbar-mainmenu-btn" picking-mode="Position"/>
        </ui:VisualElement>

        <ui:Label name="ToastLabel" text="" picking-mode="Ignore" class="toast-label"/>
        <ui:Label name="PreviewCostLabel" text="$1,250" picking-mode="Ignore" class="preview-cost-label"/>

        <ui:VisualElement name="menu-overlay" picking-mode="Ignore" class="menu-overlay" style="display: none;">
            <ui:VisualElement name="menu-panel" class="menu-panel" picking-mode="Position">
                <ui:Label text="Going home already?" class="menu-panel-title"/>
                <ui:Button name="MenuMainMenuButton"  text="MAIN MENU"  class="menu-panel-btn menu-panel-btn-save"   picking-mode="Position"/>
                <ui:Button name="MenuSettingsButton"  text="SETTINGS"   class="menu-panel-btn menu-panel-btn-save"   picking-mode="Position"/>
                <ui:Button name="MenuSaveButton"      text="SAVE GAME"  class="menu-panel-btn menu-panel-btn-save"   picking-mode="Position"/>
                <ui:Button name="MenuLoadButton"      text="LOAD GAME"  class="menu-panel-btn menu-panel-btn-save"   picking-mode="Position"/>
                <ui:Button name="MenuResumeButton"    text="RESUME GAME" class="menu-panel-btn menu-panel-btn-save"   picking-mode="Position"/>
                <ui:Button name="MenuExitButton"      text="EXIT GAME"  class="menu-panel-btn menu-panel-btn-resume" picking-mode="Position"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- In-game settings overlay -->
        <ui:VisualElement name="in-game-settings-overlay" class="confirm-overlay" picking-mode="Position" style="display: none;">
            <ui:VisualElement name="in-game-settings-panel" class="in-game-settings-panel" picking-mode="Position">
                <ui:Label text="SETTINGS" class="popup-title" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;);"/>
                <ui:Label text="WHAT&apos;S YOUR HORSEPOWER?" class="settings-section-header"/>
                <ui:VisualElement class="settings-row">
                    <ui:Button name="ig-btn-toaster"  text="TOASTER"    class="gfx-btn gfx-btn-red"/>
                    <ui:Button name="ig-btn-good"     text="GOOD ENOUGH" class="gfx-btn gfx-btn-green"/>
                    <ui:Button name="ig-btn-screamin" text="SCREAMIN"   class="gfx-btn gfx-btn-blue"/>
                </ui:VisualElement>
                <ui:Label text="DIFFICULTY" class="settings-section-header"/>
                <ui:VisualElement class="settings-row">
                    <ui:Button name="ig-btn-diff-clerk"      text="CLERK"      class="gfx-btn gfx-btn-green"/>
                    <ui:Button name="ig-btn-diff-supervisor" text="SUPERVISOR" class="gfx-btn gfx-btn-blue"/>
                    <ui:Button name="ig-btn-diff-manager"    text="MANAGER"    class="gfx-btn gfx-btn-red"/>
                </ui:VisualElement>
                <ui:Label text="RESOLUTION" class="settings-section-header"/>
                <ui:DropdownField name="ig-resolution-dropdown" class="settings-dropdown"/>
                <ui:Label text="VOLUME" class="settings-section-header"/>
                <ui:VisualElement class="settings-slider-row">
                    <ui:Label text="Game" class="settings-slider-label"/>
                    <ui:Slider name="ig-slider-game-volume" low-value="0" high-value="1" value="1" class="settings-slider"/>
                </ui:VisualElement>
                <ui:VisualElement class="settings-slider-row">
                    <ui:Label text="Music" class="settings-slider-label"/>
                    <ui:Slider name="ig-slider-music-volume" low-value="0" high-value="1" value="0.7" class="settings-slider"/>
                </ui:VisualElement>
                <ui:Button name="ig-settings-done" text="DONE" class="popup-btn popup-btn-green" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); margin-top: 10px;" picking-mode="Position"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Resolution confirm for in-game settings -->
        <ui:VisualElement name="ig-res-confirm-overlay" class="confirm-overlay" picking-mode="Position" style="display: none;">
            <ui:VisualElement name="ig-res-confirm-panel" class="confirm-panel" picking-mode="Position">
                <ui:Label text="ACCEPT CHANGES?" class="popup-title confirm-title" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;);"/>
                <ui:VisualElement class="settings-action-row">
                    <ui:Button name="ig-btn-res-yes" text="YES" class="menu-btn menu-btn-blue settings-action-btn" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;);" picking-mode="Position"/>
                    <ui:Button name="ig-btn-res-no"  text="NO"  class="menu-btn menu-btn-grey settings-action-btn" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;);" picking-mode="Position"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Welcome Overlay â€” inside Root so it inherits the full-screen hud-root bounds -->
        <ui:VisualElement name="welcome-backdrop" picking-mode="Position" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.88); align-items: center; justify-content: center;">
            <ui:VisualElement name="welcome-popup" style="width: 900px; background-color: rgba(30, 38, 46, 0.98); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-color: rgb(92, 155, 196); border-right-color: rgb(92, 155, 196); border-bottom-color: rgb(92, 155, 196); border-left-color: rgb(92, 155, 196); border-radius: 32px; padding: 56px 64px; align-items: center; flex-direction: column;">
                <ui:VisualElement name="boss-avatar" style="width: 280px; height: 280px; border-radius: 16px; background-color: rgb(22, 28, 36); -unity-background-scale-mode: scale-to-fit; border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; border-top-color: rgb(92, 155, 196); border-right-color: rgb(92, 155, 196); border-bottom-color: rgb(92, 155, 196); border-left-color: rgb(92, 155, 196); margin-bottom: 20px;"/>
                <ui:Label name="welcome-title" text="MISTER Tug Dudley" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 52px; color: rgb(92, 155, 196); -unity-text-align: middle-center; margin-bottom: 24px;"/>
                <ui:Label name="welcome-text" text="" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/Fonts/Fredoka,Grandstander,Winky_Rough,Work_Sans/Fredoka/static/Fredoka-Medium.ttf?fileID=12800000&amp;guid=189cc47193d14cf48980be934208aa1c&amp;type=3#Fredoka-Medium&quot;); font-size: 26px; color: rgb(220, 235, 245); white-space: normal; margin-bottom: 36px; width: 100%;"/>
                <ui:Button name="btn-dismiss" text="GET TO WORK!" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 30px; height: 72px; width: 100%; background-color: rgb(76, 144, 192); border-bottom-color: rgb(44, 94, 130); border-bottom-width: 5px; border-top-width: 0; border-left-width: 0; border-right-width: 0; border-radius: 6px; color: rgb(255, 255, 255); -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Employee Info Panel -->
        <ui:VisualElement name="employee-info-panel" picking-mode="Position" style="display: none; position: absolute; top: 100px; left: 100px; width: 300px; background-color: rgba(30, 38, 46, 0.98); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-color: rgb(92, 155, 196); border-right-color: rgb(92, 155, 196); border-bottom-color: rgb(92, 155, 196); border-left-color: rgb(92, 155, 196); border-radius: 16px; padding: 12px; flex-direction: column;">
            <!-- Header: job icon + name + id -->
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 10px; margin-top: 2px; margin-left: 0; margin-right: 0;">
                <ui:VisualElement name="employee-job-icon" style="width: 52px; height: 52px; background-color: rgb(22, 28, 36); border-radius: 8px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(92, 155, 196); border-right-color: rgb(92, 155, 196); border-bottom-color: rgb(92, 155, 196); border-left-color: rgb(92, 155, 196); margin-right: 10px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit;"/>
                <ui:VisualElement style="flex-direction: column; flex-grow: 1; flex-shrink: 1;">
                    <ui:Label name="employee-name" text="JORDAN BARNES" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 18px; color: rgb(234, 244, 255); -unity-text-align: upper-left; white-space: normal;"/>
                    <ui:Label name="employee-id" text="EMPLOYEE ID: WHSE 024" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 12px; color: rgb(150, 190, 220); -unity-text-align: upper-left;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Large portrait image — edge-to-edge fill -->
            <ui:VisualElement style="height: 260px; align-items: stretch; justify-content: stretch; margin-bottom: 12px;">
                <ui:VisualElement name="employee-avatar" style="flex-grow: 1; border-radius: 8px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: rgb(92, 155, 196); border-right-color: rgb(92, 155, 196); border-bottom-color: rgb(92, 155, 196); border-left-color: rgb(92, 155, 196); background-color: rgba(22, 28, 36, 0.80); -unity-background-scale-mode: scale-to-fit; flex-shrink: 0;"/>
            </ui:VisualElement>
            <!-- Stats -->
            <ui:VisualElement style="flex-direction: column;">
                <!-- Fatigue -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 7px;">
                    <ui:VisualElement style="width: 20px; height: 20px; background-color: rgb(220, 60, 60); border-radius: 4px; margin-right: 8px; flex-shrink: 0;"/>
                    <ui:Label text="FATIGUE" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 13px; color: rgb(220, 60, 60); width: 68px; -unity-text-align: middle-left; flex-shrink: 0;"/>
                    <ui:VisualElement style="flex-grow: 1; height: 14px; background-color: rgba(0, 0, 0, 0.45); border-radius: 7px; overflow: hidden; margin-right: 6px;">
                        <ui:VisualElement name="fatigue-bar-fill" style="width: 25%; height: 100%; background-color: rgb(220, 60, 60); border-radius: 7px;"/>
                    </ui:VisualElement>
                    <ui:Label name="fatigue-value" text="-25%" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 12px; color: rgb(220, 60, 60); width: 40px; -unity-text-align: middle-right; flex-shrink: 0;"/>
                </ui:VisualElement>
                <!-- Safety -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 7px;">
                    <ui:VisualElement style="width: 20px; height: 20px; background-color: rgb(236, 201, 60); border-radius: 4px; margin-right: 8px; flex-shrink: 0;"/>
                    <ui:Label text="SAFETY" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 13px; color: rgb(236, 201, 60); width: 68px; -unity-text-align: middle-left; flex-shrink: 0;"/>
                    <ui:VisualElement style="flex-grow: 1; height: 14px; background-color: rgba(0, 0, 0, 0.45); border-radius: 7px; overflow: hidden; margin-right: 6px;">
                        <ui:VisualElement name="safety-bar-fill" style="width: 60%; height: 100%; background-color: rgb(236, 201, 60); border-radius: 7px;"/>
                    </ui:VisualElement>
                    <ui:Label name="safety-value" text="-60%" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 12px; color: rgb(236, 201, 60); width: 40px; -unity-text-align: middle-right; flex-shrink: 0;"/>
                </ui:VisualElement>
                <!-- Morale -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 7px;">
                    <ui:VisualElement style="width: 20px; height: 20px; background-color: rgb(80, 200, 100); border-radius: 4px; margin-right: 8px; flex-shrink: 0;"/>
                    <ui:Label text="MORALE" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 13px; color: rgb(80, 200, 100); width: 68px; -unity-text-align: middle-left; flex-shrink: 0;"/>
                    <ui:VisualElement style="flex-grow: 1; height: 14px; background-color: rgba(0, 0, 0, 0.45); border-radius: 7px; overflow: hidden; margin-right: 6px;">
                        <ui:VisualElement name="morale-bar-fill" style="width: 90%; height: 100%; background-color: rgb(80, 200, 100); border-radius: 7px;"/>
                    </ui:VisualElement>
                    <ui:Label name="morale-value" text="-70%" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 12px; color: rgb(80, 200, 100); width: 40px; -unity-text-align: middle-right; flex-shrink: 0;"/>
                </ui:VisualElement>
                <!-- Skill -->
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 4px;">
                    <ui:VisualElement style="width: 20px; height: 20px; background-color: rgb(240, 240, 240); border-radius: 4px; margin-right: 8px; flex-shrink: 0;"/>
                    <ui:Label text="SKILL" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 13px; color: rgb(240, 240, 240); width: 68px; -unity-text-align: middle-left; flex-shrink: 0;"/>
                    <ui:VisualElement style="flex-grow: 1; height: 14px; background-color: rgba(0, 0, 0, 0.45); border-radius: 7px; overflow: hidden; margin-right: 6px;">
                        <ui:VisualElement name="skill-bar-fill" style="width: 40%; height: 100%; background-color: rgb(240, 240, 240); border-radius: 7px;"/>
                    </ui:VisualElement>
                    <ui:Label name="skill-value" text="38%" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 12px; color: rgb(240, 240, 240); width: 40px; -unity-text-align: middle-right; flex-shrink: 0;"/>
                </ui:VisualElement>
                <!-- Skill Level -->
                <ui:Label name="skill-level" text="LVL 3" style="-unity-font-definition: url(&quot;project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&amp;guid=b0b25c7081699704f917d02e28f31692&amp;type=3#LilitaOne-Regular&quot;); font-size: 22px; color: rgb(150, 190, 220); -unity-text-align: middle-center; margin-top: 6px;"/>
            </ui:VisualElement>
            <!-- Close button (last child — renders on top of everything) -->
            <ui:Button name="employee-close-btn" text="✕" style="position: absolute; top: 6px; right: 6px; width: 32px; height: 32px; background-color: rgb(200, 60, 60); color: rgb(255, 255, 255); font-size: 18px; -unity-font-style: bold; border-radius: 16px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; -unity-text-align: middle-center; padding: 0; transition: background-color 0.1s ease;"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
