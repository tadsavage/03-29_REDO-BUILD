.rsu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 15, 22, 0.45);
    align-items: center;
    justify-content: center;
    display: flex;
}

.rsu-modal {
    width: 600px;
    height: auto;
    max-height: 80vh;
    background-color: rgba(20, 28, 38, 0.82);
    border-width: 3px;
    border-color: rgb(92, 155, 196);
    border-radius: 16px;
    flex-shrink: 0;
    overflow: hidden;
    flex-direction: column;
    padding-bottom: 0;
}

.rsu-title-bar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 16px 20px 12px 20px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(92, 155, 196, 0.35);
    position: relative;
}

.rsu-title {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 28px;
    letter-spacing: -2px;
    color: rgb(207, 226, 240);
    -unity-text-align: middle-center;
}

.rsu-close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 38px;
    height: 38px;
    font-size: 20px;
    color: rgb(138, 170, 187);
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    -unity-text-align: middle-center;
}

.rsu-close:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(220, 80, 48, 0.3);
    border-color: rgb(220, 80, 48);
}

.rsu-content {
    flex-grow: 1;
    padding: 20px;
    flex-shrink: 0;
}

.rsu-section {
    flex-direction: column;
    margin-bottom: 24px;
    flex-shrink: 0;
}

.rsu-section-label {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px;
    letter-spacing: -1px;
    color: rgb(240, 126, 45);
    margin-bottom: 12px;
}

.rsu-text-field {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px;
    letter-spacing: -1px;
    color: rgb(234, 244, 255);
    background-color: rgba(22, 28, 36, 0.8);
    border-width: 1px;
    border-color: rgba(92, 155, 196, 0.35);
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 6px;
}

.rsu-text-field:focus {
    border-color: rgb(92, 155, 196);
}

.rsu-help-text {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 11px;
    letter-spacing: -0.5px;
    color: rgb(122, 153, 176);
}

.rsu-level-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.rsu-level-label {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px;
    letter-spacing: -1px;
    color: rgb(184, 212, 232);
    width: 80px;
    flex-shrink: 0;
}

.rsu-dropdown {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px;
    letter-spacing: -1px;
    color: rgb(234, 244, 255);
    background-color: rgba(22, 28, 36, 0.8);
    border-width: 1px;
    border-color: rgba(92, 155, 196, 0.35);
    border-radius: 8px;
    padding: 8px 12px;
    flex-grow: 1;
}

.rsu-dropdown:disabled {
    opacity: 0.5;
    background-color: rgba(22, 28, 36, 0.5);
}

.rsu-info-text {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 11px;
    letter-spacing: -0.5px;
    color: rgb(122, 153, 176);
    white-space: normal;
    margin-top: 12px;
}

.rsu-footer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 12px 20px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(92, 155, 196, 0.25);
    gap: 12px;
}

.rsu-btn {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px;
    letter-spacing: -1px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    border-width: 0;
    padding: 10px 24px;
}

.rsu-btn-submit {
    width: 100px;
    color: rgb(255, 255, 255);
    background-color: rgb(240, 126, 45);
}

.rsu-btn-submit:hover {
    background-color: rgb(255, 147, 68);
}

.rsu-btn-cancel {
    width: 100px;
    color: rgb(220, 234, 245);
    background-color: rgba(76, 144, 192, 0.35);
    border-width: 1px;
    border-color: rgb(76, 144, 192);
}

.rsu-btn-cancel:hover {
    background-color: rgba(76, 144, 192, 0.6);
    color: rgb(255, 255, 255);
}
