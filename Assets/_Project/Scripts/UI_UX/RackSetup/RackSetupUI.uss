/* ============================================================
   Rack Setup UI — blueprint-styled aisle configuration modal.
   Blueprint image is assigned at runtime (RackSetupUI.cs) and
   faded via .rsu-blueprint opacity below.
   ============================================================ */

.rsu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 10, 16, 0.55);
    align-items: center;
    justify-content: center;
    display: flex;
}

.rsu-modal {
    width: 880px;
    height: 660px;
    background-color: rgb(15, 23, 38);
    border-width: 3px;
    border-color: rgb(214, 138, 58);
    border-radius: 10px;
    flex-shrink: 0;
    overflow: hidden;
    /* controls are absolutely stacked over the blueprint */
}

/* Faded blueprint schematic filling the modal behind the controls */
.rsu-blueprint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.32;
    -unity-background-scale-mode: scale-and-crop;
}

/* ---------- Close ---------- */
.rsu-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 34px;
    height: 34px;
    font-size: 18px;
    color: rgb(210, 176, 140);
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 1px;
    border-color: rgba(214, 138, 58, 0.4);
    border-radius: 6px;
    -unity-text-align: middle-center;
}

.rsu-close:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(193, 39, 45, 0.6);
    border-color: rgb(193, 39, 45);
}

/* ---------- Left control column ---------- */
.rsu-controls {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 320px;
    padding: 32px 28px;
    flex-direction: column;
    background-color: rgba(11, 18, 30, 0.72);
}

/* ---------- Aisle ---------- */
.rsu-aisle-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 34px;
    flex-shrink: 0;
}

.rsu-aisle-label {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 30px;
    letter-spacing: -1px;
    color: rgb(240, 126, 45);
    margin-right: 14px;
}

.rsu-aisle-field {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 24px;
    color: rgb(24, 30, 40);
    width: 96px;
    height: 48px;
}

.rsu-aisle-field > #unity-text-input {
    background-color: rgb(228, 232, 236);
    border-width: 0;
    border-radius: 6px;
    -unity-text-align: middle-center;
    color: rgb(24, 30, 40);
}

/* ---------- Levels ---------- */
.rsu-levels {
    flex-direction: column;
    flex-grow: 1;
}

.rsu-level-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 26px;
    flex-shrink: 0;
}

.rsu-level-label {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 20px;
    letter-spacing: -1px;
    color: rgb(240, 126, 45);
    width: 92px;
    flex-shrink: 0;
}

.rsu-dropdown {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 15px;
    letter-spacing: -0.5px;
    width: 130px;
    flex-shrink: 0;
}

.rsu-dropdown > #unity-text-input,
.rsu-dropdown > .unity-base-popup-field__input {
    background-color: rgb(210, 216, 222);
    border-width: 0;
    border-radius: 6px;
    padding: 8px 10px;
    color: rgb(24, 30, 40);
}

.rsu-dropdown:disabled {
    opacity: 0.45;
}

/* ---------- Footer ---------- */
.rsu-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    margin-top: 12px;
}

.rsu-btn {
    -unity-font-definition: url("project://database/Assets/Plugins/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 18px;
    letter-spacing: -1px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    border-width: 0;
    padding: 10px 20px;
    height: 46px;
}

.rsu-btn-submit {
    color: rgb(255, 255, 255);
    background-color: rgb(76, 175, 80);
}

.rsu-btn-submit:hover {
    background-color: rgb(93, 197, 97);
}

.rsu-btn-cancel {
    color: rgb(240, 224, 210);
    background-color: rgb(122, 74, 38);
}

.rsu-btn-cancel:hover {
    background-color: rgb(150, 92, 48);
}
