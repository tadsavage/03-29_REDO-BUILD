.buildmenu-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

/* Retheme 2026-06-14: matched to the Employee Roster / Hiring Board palette.
   Back bar = rgba(20,28,38,0.82) + blue #5C9BC4 top border; button/card faces =
   rgba(34,44,56,0.55) + subtle white borders, blue hovers; selected = blue fill.
   Layout, sizes and fonts are unchanged. */
.buildmenu-bottom-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 120px;
    background-color: rgba(20, 28, 38, 0.82);
    border-top-width: 2px;
    border-top-color: rgba(92, 155, 196, 0.6);
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    overflow: visible; /* ALLOWS HOVER TOOLTIPS TO DISPLAY OUTSIDE THE BAR BOUNDS */
}

/* Only one bottom bar is up at a time — BuildMenuUI swaps this class between the
   Build and Play bars. display:none rather than opacity so the hidden bar cannot
   swallow clicks meant for the world. */
.buildmenu-bar-hidden {
    display: none;
}

/* ── Play bar buttons ────────────────────────────────────────────────────
   Same card as .buildmenu-category-button; only the icon shrinks, to leave room for
   the hotkey badge without pushing the label out of the 104px card. */
.playbar-icon {
    width: 62px;
    height: 62px;
}

.playbar-label {
    /* Slightly larger than the build labels: play-bar names are shorter ("Purchasing", "Work Queue")
       so they still fit the 90px card at 13px, where "Loss Prevention" would not. */
    font-size: 13px;
}

/* Absolute so the badge costs no vertical space — the card is already full at
   68px icon + label. Anchors to the button, which is position:relative by default. */
.playbar-key {
    position: absolute;
    top: 2px;
    right: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(150, 190, 220, 0.75);
}

/* Icons are referenced by GUID (fileID 2800000 = the PNG's Texture2D main asset), the
   same url() form the fonts above use, so no Inspector wiring and the dependency is
   packed into a build. */
.playbar-icon-devconsole {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/DevConsoleThumb.png?fileID=2800000&guid=59aec23a22a6b2e4288c2f9e06b5b574&type=3#DevConsoleThumb");
}

.playbar-icon-hiringboard {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/HiringBoardThumb.png?fileID=2800000&guid=918541899f07b2248b04e09973270879&type=3#HiringBoardThumb");
}

.playbar-icon-employeeroster {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/EmployeeRosterThumb.png?fileID=2800000&guid=ff3df38c81b7741499246e9636ab264f&type=3#EmployeeRosterThumb");
}

.playbar-icon-employeelist {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/EmployeeListThumb.png?fileID=2800000&guid=72b41feff32158545a10580bc41c37d0&type=3#EmployeeListThumb");
}

.playbar-icon-shiftmanager {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/ShiftManagerThumb.png?fileID=2800000&guid=59d3ed0b648f5e0459152b1fd1205a07&type=3#ShiftManagerThumb");
}

.playbar-icon-outbound {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/OutboundThumb.png?fileID=2800000&guid=bef9ffad1225b7c46ae53823f9de1e62&type=3#OutboundThumb");
}

.playbar-icon-workqueue {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/WorkQueueThumb.png?fileID=2800000&guid=32c13be7f77f7924b948b9f552fd630a&type=3#WorkQueueThumb");
}

.playbar-icon-newitem {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/NewItemThumb.png?fileID=2800000&guid=703546f892563b8428200ddbd177029a&type=3#NewItemThumb");
}

/* PLACEHOLDER ART: reuses the Contracts thumb because Play Bar Icons has no purchasing image yet.
   It is deliberately the same picture as button 6, which is wrong and meant to be noticed — drop a
   PurchasingThumb.png into Assets/_Project/Art/Icons/Play Bar Icons/ and repoint this one rule. */
.playbar-icon-purchasing {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/ContractsThumb.png#ContractsThumb");
}

.playbar-icon-scheduler {
    background-image: url("project://database/Assets/_Project/Art/Icons/Play%20Bar%20Icons/SchedulerThumb.png?fileID=2800000&guid=d366eaa448c876248bd93228cd2eb730&type=3#SchedulerThumb");
}

/* ── Build / Play mode tabs ──────────────────────────────────────────────
   Anchored at bottom:120px — the bar's height, not BottomBarHeight (122) — so the
   tab's bottom edge overlaps the bar's 2px top border and the active tab reads as
   one piece with the bar beneath it. */
.buildmenu-mode-tabs {
    position: absolute;
    bottom: 120px;
    left: 16px;
    display: flex;
    flex-direction: row;
    align-items: flex-end;
}

.buildmenu-mode-tab {
    height: 30px;
    min-width: 96px;
    margin: 0;
    margin-right: 4px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(34, 44, 56, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-bottom-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
    -unity-font-style: bold;
}

.buildmenu-mode-tab:hover {
    background-color: rgba(92, 155, 196, 0.25);
    border-color: rgba(92, 155, 196, 0.5);
    color: rgb(255, 255, 255);
}

/* Active tab: same fill as the bar, blue framing that continues the bar's top
   border, and 2px taller so it sits slightly proud of its inactive sibling. */
.buildmenu-mode-tab-active {
    height: 32px;
    background-color: rgba(20, 28, 38, 0.82);
    border-color: rgba(92, 155, 196, 0.6);
    border-bottom-width: 0;
    color: rgb(255, 255, 255);
}

.buildmenu-mode-tab-active:hover {
    background-color: rgba(20, 28, 38, 0.82);
    border-color: rgba(92, 155, 196, 0.6);
}

.buildmenu-category-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 1;
}

.buildmenu-utility-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 0;
    /* Explicitly prevent your utilities row from over-expanding */
    max-width: 520px !important;
}

/* Category buttons — card face.
   Width cut 25% (120 -> 90) so ten categories, the utility row and the dev HUD all fit on one bar
   without the utilities being pushed off the right edge. Height is deliberately UNCHANGED: the bar
   is a fixed 120px and the cards should still fill it. The icon below is cut by the same 25% —
   background-size:contain scales the IMAGE to its element, but the element itself was 96px wide and
   would have overflowed a 90px card (82px of content box after padding). */
.buildmenu-category-button {
    width: 90px;
    height: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(34, 44, 56, 0.55);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    opacity: 1;
}

/* Hover — blue card highlight */
.buildmenu-category-button:hover {
    background-color: rgba(46, 60, 76, 0.65);
    border-color: rgba(92, 155, 196, 0.35);
    opacity: 0.95;
}

/* Selected — dark, near-neutral grey, matching the resting item-card look (see the "Rat"/"Fir Tree"
   cards in .buildmenu-item-button) rather than any blue fill. Two rounds of feedback: the first pass
   (a muted blue-grey at 0.85) still read as blue — this drops the color almost entirely and leans on
   darkness + opacity instead, with only a faint blue tint left in the border so "selected" is still
   distinguishable from the unselected card's near-identical (but lower-opacity, white-bordered) rest
   state. */
.buildmenu-category-button.selected {
    background-color: rgba(24, 30, 38, 0.92);
    border-color: rgba(150, 190, 220, 0.3);
    opacity: 1;
}

/* Focus/Active — Unity's built-in runtime theme paints every Button with its own solid, fully-opaque
   blue fill/border the instant it's pressed (:active) and/or focused (:focus), and a runtime Button
   never blurs itself afterward, so that fill just sits there stuck on top of whichever state above is
   actually meant to be showing (this is what made a play-bar button look like a bright opaque blue box
   the instant you clicked it, staying that way until the panel was closed and something else took
   focus). The previous pass only overrode :focus, at the same specificity as this stylesheet's other
   two-selector rules — evidently still losing to the built-in theme, whose rule apparently carries
   higher specificity (it likely qualifies by element type as well as pseudo-class). !important forces
   every one of these combinations to win outright rather than re-litigating cascade order against an
   opaque, unreadable built-in theme. Every state this bar cares about is already defined above, so
   :focus/:active are simply reset back to match rest/hover/selected. */
.buildmenu-category-button:focus,
.buildmenu-category-button:active {
    background-color: rgba(34, 44, 56, 0.55) !important;
    border-color: rgba(255, 255, 255, 0.08) !important;
}

.buildmenu-category-button:focus:hover,
.buildmenu-category-button:active:hover {
    background-color: rgba(46, 60, 76, 0.65) !important;
    border-color: rgba(92, 155, 196, 0.35) !important;
}

.buildmenu-category-button.selected:focus,
.buildmenu-category-button.selected:active {
    background-color: rgba(24, 30, 38, 0.92) !important;
    border-color: rgba(150, 190, 220, 0.3) !important;
}

.buildmenu-category-button.selected:focus:hover,
.buildmenu-category-button.selected:active:hover {
    background-color: rgba(24, 30, 38, 0.92) !important;
    border-color: rgba(150, 190, 220, 0.3) !important;
}

.buildmenu-category-icon {
    width: 72px;
    height: 88px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.buildmenu-category-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    /* 16 -> 12 to follow the card down from 120px to 90px. The binding case is "Loss Prevention" at
       15 characters against ~82px of content box; at 16px it overran the old 120px card too, which
       is why it looked like it was leaning on its neighbour. nowrap is kept deliberately — the card
       is only 104px tall with an 88px icon in it, so there is no room for a second line to wrap to. */
    font-size: 12px;
    -unity-text-letter-spacing: -1px;
    -unity-font-style: normal;
    color: #96BEDC;
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-utility-button {
    width: 84px;
    height: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(34, 44, 56, 0.55);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 4px;
    margin: 4px;
    opacity: 1;
}

.buildmenu-utility-button:hover {
    background-color: rgba(46, 60, 76, 0.65);
    border-color: rgba(92, 155, 196, 0.35);
    opacity: 0.95;
}

.buildmenu-utility-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-bottom: 4px;
    -unity-background-image-tint-color: #96BEDC;
}

.buildmenu-utility-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 11px;
    -unity-text-letter-spacing: -1px;
    -unity-font-style: bold;
    color: #96BEDC;
    -unity-text-align: middle-center;
    -unity-text-wrap: nowrap;
}

.buildmenu-submenu {
    position: absolute;
    left: 16px;
    bottom: 128px;
    opacity: 0;
    display: none;
}

.buildmenu-submenu-open {
    opacity: 1;
    display: flex;
}

.buildmenu-submenu-closed {
    opacity: 0;
    display: none;
}

/* Submenu dropdown — back panel with blue framing */
.buildmenu-submenu-root {
    background-color: rgba(20, 28, 38, 0.92);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgb(92, 155, 196);
    padding: 6px;
    padding-right: 8px;
    max-height: 320px;
    overflow: hidden;
}

.buildmenu-submenu-scroll {
    flex-grow: 1;
}

/* Item buttons — card face */
.buildmenu-item-button {
    width: 260px;
    height: 64px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 6px;
    margin-bottom: 6px;
    background-color: rgba(34, 44, 56, 0.55);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    opacity: 1;
}

/* Item cards — blue hover highlight */
.buildmenu-item-button:hover {
    background-color: rgba(46, 60, 76, 0.65);
    border-color: rgba(92, 155, 196, 0.35);
    opacity: 1;
}

.buildmenu-item-icon {
    width: 56px;
    height: 56px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 10px;
}

.buildmenu-item-text {
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
}

.buildmenu-item-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 15px;
    -unity-text-letter-spacing: 0px;
    color: #96BEDC;
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

/* Item costs — kept as the soft gold accent */
.buildmenu-item-cost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px;
    -unity-text-letter-spacing: 0px;
    color: #ECC98A;
    -unity-text-wrap: nowrap;
    overflow: hidden;
    -unity-text-overflow: ellipsis;
}

/* ==========================================
   PIXEL-PERFECT SCROLLBAR GAP OVERRIDES
   ========================================== */

.buildmenu-submenu-scroll .unity-scroller {
    width: 14px;
    background-color: transparent;
    margin-top: 4px;
    margin-bottom: 4px;
    margin-right: 6px;
}

.buildmenu-submenu-scroll .unity-scroller__slider {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    margin: 0;
    border-width: 0;
}

.buildmenu-submenu-scroll .unity-scroller__thumb {
    background-color: rgba(92, 155, 196, 0.45);
    border-radius: 4px;
    border-width: 0;
}

.buildmenu-submenu-scroll .unity-scroller__thumb:hover {
    background-color: rgba(92, 155, 196, 0.7);
}

.buildmenu-submenu-scroll .unity-scroller__low-button,
.buildmenu-submenu-scroll .unity-scroller__high-button {
    display: none;
    visibility: hidden;
    height: 0;
    width: 0;
    margin: 0;
    padding: 0;
}

/* THE SELECTION DISPLAY BOX CONTAINER — card face */
.buildmenu-stationed-popup {
    flex-grow: 1;
    max-width: 400px;
    height: auto !important;
    min-height: 104px !important;
    margin: 8px 16px;
    padding: 6px 12px !important;
    background-color: rgba(34, 44, 56, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}


/* THE ITEM TITLE TEXT — scoped to stationed popup only, floating popup uses WorldHoverPopup.uss */
.buildmenu-stationed-popup .world-hover-title, .buildmenu-stationed-popup #HoverTitle {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular") !important;
    font-size: 22px !important;
    height: auto !important;
    max-height: none !important;
    color: #FFFFFF !important;
    margin-top: 0 !important;
    margin-bottom: 2px !important;
    -unity-text-align: middle-center !important;
}

/* FORCE THE LOWER ROW LABELS — scoped to stationed popup only */
.buildmenu-stationed-popup Label, .buildmenu-stationed-popup #HoverCost, .buildmenu-stationed-popup #HoverHourlyCost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular") !important;
    font-size: 12px !important;
    height: auto !important;
    max-height: none !important;
    color: #ECC98A !important;
    margin-top: 1px !important;
    margin-bottom: 1px !important;
    -unity-text-align: middle-center !important;
}

/* EXCLUDE THE TITLE SO IT ALWAYS REMAINS WHITE */
.buildmenu-stationed-popup #HoverTitle, .buildmenu-stationed-popup .world-hover-title {
    color: #FFFFFF !important;
}
/* ==========================================
   DYNAMIC CUSTOM WALL ICON STYLE OVERRIDES
   ========================================== */

.wall-lower-icon {
    width: 90px !important;
    height: 90px !important;
    align-self: center;
    -unity-background-image-tint-color: #96BEDC;
}

.wall-raise-icon {
    width: 90px !important;
    height: 90px !important;
    align-self: center;
    -unity-background-image-tint-color: #96BEDC;
}
