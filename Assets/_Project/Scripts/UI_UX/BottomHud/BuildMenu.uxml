<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/3.%20UI/2.BottomHud/buildmenuNEW.uss?fileID=7433441132597879392&amp;guid=6451556a33fb0be46aa059d66682505f&amp;type=3#buildmenuNEW"/>
    <Style src="project://database/Assets/3.%20UI/4.PopupUIs/WorldHoverPopup.uss?fileID=7433441132597879392&amp;guid=e7f4862e76357b3469d9ad92258f0600&amp;type=3#WorldHoverPopup"/>
    <Style src="MiniDockTimeline.uss"/>

    <ui:VisualElement name="BuildMenuRoot" picking-mode="Ignore" class="buildmenu-root">
        <ui:VisualElement name="SubmenuContainer" picking-mode="Position" class="buildmenu-submenu buildmenu-submenu-closed">
            <ui:VisualElement name="SubmenuRoot" picking-mode="Position" class="buildmenu-submenu-root">
                <ui:ScrollView name="SubmenuScroll" class="buildmenu-submenu-scroll">
                    <ui:VisualElement name="SubmenuContent"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="BottomBarBuildUI" picking-mode="Ignore" class="buildmenu-bottom-bar buildmenu-bar-hidden">
        <ui:VisualElement name="CategoryRow" picking-mode="Position" class="buildmenu-category-row"/>
        <ui:VisualElement name="UtilityRow" picking-mode="Position" class="buildmenu-utility-row"/>
    </ui:VisualElement>

    <!-- Play-mode ("ORDERS" tab) counterpart to the build bar. Same chrome, same two-row layout;
         BuildMenuUI shows exactly one of the bars at a time.

         PlayBtn0/5/7/8/9 mirror hotkeys 0/5/7/8/9 and are wired straight to UIKeyBindingManager.
         ToggleUI, so a click and a keypress take the identical path — the key badge in each corner is
         the same number. If a hotkey is ever reassigned, the button follows it automatically; only the
         label, icon class and badge here need updating. PlayBtn1/2/3/4/6 (Dev Console/Hiring Board/
         Roster/Employees/Shifts) moved to BottomBarStaffUI's STAFF tab below — the button NAMES stayed
         the same since BuildMenuUI looks them up by name across the whole document, so only their
         parent moved. -->
    <ui:VisualElement name="BottomBarPlayUI" picking-mode="Ignore" class="buildmenu-bottom-bar">
        <ui:VisualElement name="PlayCategoryRow" picking-mode="Position" class="buildmenu-category-row">

            <ui:Button name="PlayBtn5" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-newitem"/>
                <ui:Label text="New Item" class="buildmenu-category-label playbar-label playbar-label-two-line"/>
                <ui:Label text="5" class="playbar-key"/>
            </ui:Button>

            <ui:Button name="PlayBtn7" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-workqueue"/>
                <ui:Label text="Work Queue" class="buildmenu-category-label playbar-label playbar-label-two-line"/>
                <ui:Label text="7" class="playbar-key"/>
            </ui:Button>

            <!-- Contracts panel, relabeled "Outbound" — kept next to Inbound (9) since the two
                 together cover outbound (Outbound/Contracts) and inbound (Inbound). -->
            <ui:Button name="PlayBtn8" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-outbound"/>
                <ui:Label text="Outbound Orders" class="buildmenu-category-label playbar-label playbar-label-two-line"/>
                <ui:Label text="8" class="playbar-key"/>
            </ui:Button>

            <ui:Button name="PlayBtn9" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-purchasing"/>
                <ui:Label text="Inbound Orders" class="buildmenu-category-label playbar-label playbar-label-two-line"/>
                <ui:Label text="9" class="playbar-key"/>
            </ui:Button>

            <!-- Scheduler panel, extracted from the Outbound Order Manager's old Scheduler tab. -->
            <ui:Button name="PlayBtn0" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-scheduler"/>
                <ui:Label text="Order Scheduler" class="buildmenu-category-label playbar-label playbar-label-two-line"/>
                <ui:Label text="0" class="playbar-key"/>
            </ui:Button>

            <!-- Item Listing report (same window as the Reports bar's Item Listing button). -->
            <ui:Button name="OrdersBtnItemListing" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-itemlisting"/>
                <ui:Label text="Item Listing" class="buildmenu-category-label playbar-label playbar-label-two-line"/>
            </ui:Button>

        </ui:VisualElement>
        <!-- Read-only picture of TODAY's dock schedule (MiniDockTimeline.cs fills the door rows and chips). -->
        <ui:VisualElement name="MiniDockTimeline" picking-mode="Position" class="mini-timeline">
            <ui:VisualElement picking-mode="Ignore" class="mini-timeline-header">
                <ui:Label text="DOOR" picking-mode="Ignore" class="mini-timeline-corner"/>
                <ui:VisualElement name="MiniTimelineHours" picking-mode="Ignore" class="mini-timeline-hours">
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="mini-timeline-body">
                <ui:VisualElement name="MiniTimelineDoors" picking-mode="Ignore" class="mini-timeline-doors"/>
                <ui:VisualElement name="MiniTimelineGrid" class="mini-timeline-grid">
                    <ui:Label name="MiniTimelineEmpty" text="No doors yet" picking-mode="Ignore" class="mini-timeline-empty"/>
                    <ui:VisualElement name="MiniTimelineNow" picking-mode="Ignore" class="mini-timeline-now"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="PlayUtilityRow" picking-mode="Position" class="buildmenu-utility-row"/>
    </ui:VisualElement>

    <!-- Staff mode bar: the HR/roster/scheduling panels, split out of Orders so that tab isn't
         crowded with buttons unrelated to running orders. Same chrome/layout as the other bars. -->
    <ui:VisualElement name="BottomBarStaffUI" picking-mode="Ignore" class="buildmenu-bottom-bar buildmenu-bar-hidden">
        <ui:VisualElement name="StaffCategoryRow" picking-mode="Position" class="buildmenu-category-row">

            <!-- Dev Console (key 1) moved to the DEV TOOLS bar on 2026-11-08. -->

            <ui:Button name="PlayBtn2" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-hiringboard"/>
                <ui:Label text="Hiring Board" class="buildmenu-category-label playbar-label"/>
                <ui:Label text="2" class="playbar-key"/>
            </ui:Button>

            <ui:Button name="PlayBtn3" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-employeeroster"/>
                <ui:Label text="Roster" class="buildmenu-category-label playbar-label"/>
                <ui:Label text="3" class="playbar-key"/>
            </ui:Button>

            <ui:Button name="PlayBtn4" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-employeelist"/>
                <ui:Label text="Employees" class="buildmenu-category-label playbar-label"/>
                <ui:Label text="4" class="playbar-key"/>
            </ui:Button>

            <ui:Button name="PlayBtn6" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-shiftmanager"/>
                <ui:Label text="Shifts" class="buildmenu-category-label playbar-label"/>
                <ui:Label text="6" class="playbar-key"/>
            </ui:Button>

        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Reports mode bar: three plain buttons (Financial/Operational/Inventory), same card style as
         the other bars' buttons, just without an icon/hotkey badge — clicking one opens that report
         in its own floating/draggable/resizable window (ReportsPanelController), instead of the old
         floating popup-with-subtabs. Wired up in BuildMenuUI.CacheElements. -->
    <ui:VisualElement name="BottomBarReportsUI" picking-mode="Ignore" class="buildmenu-bottom-bar buildmenu-bar-hidden">
        <ui:VisualElement name="ReportsCategoryRow" picking-mode="Position" class="buildmenu-category-row">

            <ui:Button name="ReportsBtnFinancial" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-report-financial"/>
                <ui:Label text="Financial" class="buildmenu-category-label reports-category-label"/>
            </ui:Button>

            <ui:Button name="ReportsBtnOperational" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-report-operations"/>
                <ui:Label text="Operational" class="buildmenu-category-label reports-category-label"/>
            </ui:Button>

            <ui:Button name="ReportsBtnInventory" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-report-capacity"/>
                <ui:Label text="Warehouse Capacity" class="buildmenu-category-label reports-category-label playbar-label-two-line"/>
            </ui:Button>

            <!-- Item Listing lives on the ORDERS tab only (2026-11-08). -->

        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Utilities bar (2026-11-08): the three authoring tools that used to hang off the top bar / a pallet click. Each button toggles
         its own window; wired in BuildMenuUI.CacheElements. -->
    <ui:VisualElement name="BottomBarUtilitiesUI" picking-mode="Ignore" class="buildmenu-bottom-bar buildmenu-bar-hidden">
        <ui:VisualElement name="UtilitiesCategoryRow" picking-mode="Position" class="buildmenu-category-row">

            <ui:Button name="UtilBtnPalletBuilder" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-outbound"/>
                <ui:Label text="Pallet Builder" class="buildmenu-category-label reports-category-label"/>
            </ui:Button>

            <ui:Button name="UtilBtnItemCreator" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-newitem"/>
                <ui:Label text="Item Creator" class="buildmenu-category-label reports-category-label"/>
            </ui:Button>

            <ui:Button name="UtilBtnAod" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-employeeroster"/>
                <ui:Label text="AOD" class="buildmenu-category-label reports-category-label"/>
            </ui:Button>

        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Dev Tools bar (2026-11-08): one button per tool; each opens ONLY that tool in the Tools window (the old tab strip is gone). -->
    <ui:VisualElement name="BottomBarDevToolsUI" picking-mode="Ignore" class="buildmenu-bottom-bar buildmenu-bar-hidden">
        <ui:VisualElement name="DevToolsCategoryRow" picking-mode="Position" class="buildmenu-category-row">

            <ui:Button name="DevBtnConsole" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-devconsole"/>
                <ui:Label text="Dev Console" class="buildmenu-category-label playbar-label"/>
                <ui:Label text="1" class="playbar-key"/>
            </ui:Button>

            <ui:Button name="DevBtnSettings" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-shiftmanager"/>
                <ui:Label text="Dev Settings" class="buildmenu-category-label playbar-label"/>
            </ui:Button>

            <ui:Button name="DevBtnHal" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-report-operations"/>
                <ui:Label text="HAL 9000" class="buildmenu-category-label playbar-label"/>
            </ui:Button>

            <ui:Button name="DevBtnBalance" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-report-financial"/>
                <ui:Label text="Balance" class="buildmenu-category-label playbar-label"/>
            </ui:Button>

        </ui:VisualElement>
    </ui:VisualElement>

    <!-- UI Control bar (2026-11-08): HUD pieces the player can switch on and off. Just Objectives for now. -->
    <ui:VisualElement name="BottomBarUiControlUI" picking-mode="Ignore" class="buildmenu-bottom-bar buildmenu-bar-hidden">
        <ui:VisualElement name="UiControlCategoryRow" picking-mode="Position" class="buildmenu-category-row">

            <ui:Button name="UiBtnObjectives" class="buildmenu-category-button playbar-button">
                <ui:VisualElement class="buildmenu-category-icon playbar-icon playbar-icon-workqueue"/>
                <ui:Label text="Objectives" class="buildmenu-category-label reports-category-label"/>
            </ui:Button>

        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Sits directly on top of the bar's 2px border so the active tab reads as part of the bar. -->
    <!-- BUILD / ORDERS tab hover tooltips are wired in BuildMenuUI.AttachModeTabTooltip, not the
         built-in `tooltip` attribute — that property only renders inside the Editor's own UI and
         never shows on a runtime UIDocument HUD like this one. -->
    <ui:VisualElement name="ModeTabs" picking-mode="Position" class="buildmenu-mode-tabs">
        <ui:Button name="TabPlay" text="ORDERS" class="buildmenu-mode-tab buildmenu-mode-tab-active"/>
        <ui:Button name="TabBuild" text="BUILD" class="buildmenu-mode-tab"/>
        <ui:Button name="TabStaff" text="STAFF" class="buildmenu-mode-tab"/>
        <ui:Button name="TabReports" text="REPORTS" class="buildmenu-mode-tab"/>
        <ui:Button name="TabUtilities" text="UTILITIES" class="buildmenu-mode-tab"/>
        <ui:Button name="TabDevTools" text="DEV TOOLS" class="buildmenu-mode-tab"/>
        <ui:Button name="TabUiControl" text="UI CONTROL" class="buildmenu-mode-tab"/>
    </ui:VisualElement>
</ui:UXML>
