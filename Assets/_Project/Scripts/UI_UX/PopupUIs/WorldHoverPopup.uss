/* ── FLOATING OBJECT HOVER POPUP ─────────────────────────
   Follows the cursor. Compact blue-gray theme matching Toast.
   ───────────────────────────────────────────────────────── */

.world-hover-popup {
    position: absolute;
    background-color: rgba(18, 26, 36, 0.95);
    border-width: 3px;
    border-color: #5C9BC4;
    border-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    min-width: 100px;
    display: none;
    flex-direction: column;
    picking-mode: ignore;
    top: 0;
    left: 0;
}

.world-hover-popup.show {
    display: flex;
}

.world-hover-title {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px;
    color: #CFE2F0;
    margin-bottom: 3px;
}

.world-hover-cost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 11px;
    color: rgba(156, 191, 218, 0.85);
    margin-bottom: 2px;
}

.world-hover-hourlyCost {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 10px;
    color: rgba(156, 191, 218, 0.55);
}
