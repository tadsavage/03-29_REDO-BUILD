/* ════════════════════════════════════════════════════════════════════════════
   HIRING BOARD
   Blue/gray aesthetic matching EmployeeListPanel, with orange HIRE accent.
   Panel is intentionally semi-transparent so the warehouse shows through.
   Cards are built in code (HiringBoardUI) using the .hb-card* classes below.
   ════════════════════════════════════════════════════════════════════════════ */

/* ── Overlay ─────────────────────────────────────────────────────────────── */
.hb-overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(10, 15, 22, 0.45);
    align-items: center; justify-content: center;
}

/* ── Modal panel ─────────────────────────────────────────────────────────── */
.hb-modal {
    width: 1120px;
    background-color: rgba(20, 28, 38, 0.82);
    border-width: 3px; border-color: #5C9BC4; border-radius: 16px;
    flex-shrink: 0; overflow: hidden; flex-direction: column;
    padding-bottom: 6px;
}

/* ── Title bar ───────────────────────────────────────────────────────────── */
.hb-title-bar {
    flex-direction: row; align-items: center; justify-content: center;
    padding: 16px 20px 12px 20px; flex-shrink: 0;
    border-bottom-width: 1px; border-bottom-color: rgba(92,155,196,0.35);
}
.hb-title {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 30px; letter-spacing: -3px; color: #CFE2F0;
    -unity-text-align: middle-center;
}
.hb-close {
    position: absolute; top: 12px; right: 14px;
    width: 38px; height: 38px; font-size: 20px; color: #8AAABB;
    background-color: rgba(255,255,255,0.05);
    border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 8px;
    -unity-text-align: middle-center;
}
.hb-close:hover {
    color: #FFFFFF; background-color: rgba(220,80,48,0.30); border-color: #DC5030;
}

/* ── Column header row ───────────────────────────────────────────────────── */
.hb-header {
    flex-direction: row; align-items: center;
    padding: 8px 18px 6px 18px; flex-shrink: 0;
}
.hb-header-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 12px; letter-spacing: -1px; color: #7A99B0;
    -unity-text-align: middle-left;
}
/* Sortable headers — clickable, highlight on hover and when active */
.hb-header-sortable { color: #8AAABB; }
.hb-header-sortable:hover { color: #CFE2F0; }
.hb-header-active { color: #F07E2D; }

/* ── Scroll area (≈6 cards visible) ──────────────────────────────────────── */
.hb-scroll {
    height: 540px; flex-shrink: 0;
}
.hb-list {
    flex-direction: column; padding: 2px 14px;
}

/* ── Card ────────────────────────────────────────────────────────────────── */
.hb-card {
    flex-direction: row; align-items: center;
    height: 80px; margin-bottom: 8px; padding: 8px 4px;
    background-color: rgba(34, 44, 56, 0.55);
    border-width: 1px; border-color: rgba(255,255,255,0.08);
    border-radius: 10px; flex-shrink: 0;
}
.hb-card:hover {
    background-color: rgba(46, 60, 76, 0.65);
    border-color: rgba(92,155,196,0.35);
}
/* Rejected counter — red tint applied during the fly-off animation */
.hb-card-rejected {
    background-color: rgba(200, 60, 60, 0.55);
    border-color: rgba(220, 80, 48, 0.85);
}
/* Successful hire — bright Kelly-green tint applied during the fly-off animation */
.hb-card-hired {
    background-color: rgba(70, 200, 80, 0.60);
    border-color: rgba(80, 220, 90, 0.90);
}

/* Column: portrait */
.hb-col-portrait { width: 56px; flex-shrink: 0; align-items: center; }
.hb-portrait {
    width: 56px; height: 56px; border-radius: 8px;
    background-color: rgba(22, 28, 36, 0.80);
    border-width: 2px; border-color: #5C9BC4;
    /* Crop from the TOP so the face shows, not the torso. */
    background-size: cover;
    background-position-y: top;
    background-repeat: no-repeat;
}

/* Column: name */
.hb-col-name { flex-grow: 1; flex-shrink: 1; flex-direction: column; padding-left: 12px; }
.hb-firstname {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px; letter-spacing: -1px; color: #8AAABB; -unity-text-align: upper-left;
}
.hb-lastname {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 18px; letter-spacing: -2px; color: #EAF4FF; -unity-text-align: upper-left;
}

/* Column: position (icon + label) */
.hb-col-position { width: 180px; flex-shrink: 0; flex-direction: row; align-items: center; }
.hb-role-icon {
    width: 34px; height: 34px; flex-shrink: 0; margin-right: 8px;
    background-color: rgba(22, 28, 36, 0.70); border-radius: 6px;
    border-width: 1px; border-color: rgba(92,155,196,0.30);
    -unity-background-scale-mode: scale-to-fit;
}
.hb-role-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px; letter-spacing: -1px; color: #CFE2F0;
    -unity-text-align: middle-left; white-space: normal; flex-shrink: 1;
}

/* Column: experience */
.hb-col-exp { width: 90px; flex-shrink: 0; }
.hb-exp {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px; letter-spacing: -1px; color: #B8D4E8; -unity-text-align: middle-left;
}

/* Columns: strength / weakness chips */
.hb-col-trait { width: 132px; flex-shrink: 0; padding-right: 8px; }
.hb-chip {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 11px; letter-spacing: -1px; color: #CFE2F0;
    background-color: rgba(15, 20, 28, 0.55);
    border-radius: 6px; padding: 8px 8px;
    border-top-width: 2px; border-top-color: #ECC940;
    -unity-text-align: middle-center; white-space: normal;
}
.hb-chip-weak { border-top-color: #7A99B0; }

/* Column: salary */
.hb-col-salary { width: 110px; flex-shrink: 0; flex-direction: column; }
.hb-salary {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 15px; letter-spacing: -1px; color: #EAF4FF; -unity-text-align: middle-left;
}
.hb-salary-countered { color: #50C864; }
.hb-salary-note {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 9px; letter-spacing: -1px; color: #50C864; -unity-text-align: upper-left;
}

/* Column: actions */
.hb-col-actions { width: 150px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: flex-end; }
.hb-btn {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px; letter-spacing: -1px; -unity-text-align: middle-center;
    border-radius: 8px; border-width: 0; padding: 8px 0;
    margin-left: 6px;
}
.hb-btn-hire {
    width: 64px; color: #FFFFFF; background-color: #F07E2D;
}
.hb-btn-hire:hover { background-color: #FF9344; }
.hb-btn-counter {
    width: 72px; color: #DCEAF5; background-color: rgba(76,144,192,0.35);
    border-width: 1px; border-color: #4C90C0;
}
.hb-btn-counter:hover { background-color: rgba(76,144,192,0.60); color: #FFFFFF; }
.hb-btn-disabled {
    opacity: 0.35;
}

/* ── Footer ──────────────────────────────────────────────────────────────── */
.hb-footer {
    flex-direction: row; align-items: center; justify-content: space-between;
    padding: 8px 18px 4px 18px; flex-shrink: 0;
    border-top-width: 1px; border-top-color: rgba(92,155,196,0.25);
}
.hb-count {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 12px; letter-spacing: -1px; color: #7A99B0;
}
.hb-refresh {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px; letter-spacing: -1px; color: #DCEAF5;
    background-color: rgba(76,144,192,0.25);
    border-width: 1px; border-color: #4C90C0; border-radius: 8px;
    padding: 8px 18px; -unity-text-align: middle-center;
}
.hb-refresh:hover { background-color: rgba(76,144,192,0.50); color: #FFFFFF; }

/* ── Trait tooltip (hover on a strength/weakness chip) ───────────────────── */
/* Landscape rectangle, ~3 wide : 2 high. Small italic LilitaOne, thin border. */
.hb-tooltip {
    position: absolute;
    width: 210px; height: 140px;
    background-color: rgba(20, 28, 38, 0.96);
    border-width: 1px; border-color: #5C9BC4; border-radius: 8px;
    padding: 10px 12px; justify-content: center;
}
.hb-tooltip-text {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 15px; -unity-font-style: normal; letter-spacing: -1px;
    color: #CFE2F0; white-space: normal; -unity-text-align: middle-left;
}

/* ── Empty state ─────────────────────────────────────────────────────────── */
.hb-empty {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 16px; letter-spacing: -1px; color: #7A99B0;
    -unity-text-align: middle-center; padding: 40px 0;
}

/* ── Scrollbar ───────────────────────────────────────────────────────────── */
.hb-scroll .unity-scroller--vertical { width: 8px; }
.hb-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255,255,255,0.05);
}
.hb-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(92,155,196,0.35); border-radius: 4px;
}
