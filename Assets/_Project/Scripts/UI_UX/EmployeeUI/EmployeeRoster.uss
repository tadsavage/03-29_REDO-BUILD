/* ════════════════════════════════════════════════════════════════════════════
   EMPLOYEE ROSTER  (F3)
   Left-side panel of employee ID cards. Same blue/gray aesthetic as the Hiring
   Board. Cards are built in code (EmployeeRosterUI) using the .er-* classes.
   ════════════════════════════════════════════════════════════════════════════ */

.er-overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
}

/* Left-anchored panel */
.er-panel {
    position: absolute; left: 100px; top: 100px; bottom: 130px;
    width: 400px;
    background-color: rgba(18, 26, 36, 0.97);
    border-width: 3px; border-color: #5C9BC4; border-radius: 16px;
    flex-direction: column; overflow: hidden; padding-bottom: 6px;
}

/* ── Title ───────────────────────────────────────────────────────────────── */
.er-title-bar {
    flex-direction: row; align-items: center;
    padding: 14px 16px 10px 16px; flex-shrink: 0;
    background-color: rgba(12, 18, 26, 1);
    border-bottom-width: 1px; border-bottom-color: rgba(92,155,196,0.35);
}
.er-title {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 22px; letter-spacing: -2px; color: #CFE2F0; flex-grow: 1;
    -unity-text-align: middle-left;
}
.er-count {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px; color: #7A99B0; margin-right: 8px;
}
.er-close {
    width: 34px; height: 34px; font-size: 18px; color: #8AAABB;
    background-color: rgba(255,255,255,0.05);
    border-width: 1px; border-color: rgba(255,255,255,0.1); border-radius: 8px;
    -unity-text-align: middle-center;
}
.er-close:hover { color: #FFFFFF; background-color: rgba(220,80,48,0.30); border-color: #DC5030; }

/* ── Filter row ──────────────────────────────────────────────────────────── */
.er-filter-row {
    flex-direction: row; align-items: center; padding: 8px 16px 6px 16px; flex-shrink: 0;
}
.er-filter-label {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 12px; letter-spacing: -1px; color: #7A99B0; margin-right: 8px;
}
.er-filter { flex-grow: 1; }
.er-filter .unity-base-popup-field__input {
    background-color: rgba(15,20,28,0.6); border-color: #4C90C0; border-width: 1px; border-radius: 6px;
}

/* ── Scroll / list ───────────────────────────────────────────────────────── */
.er-scroll { flex-grow: 1; }
.er-list { flex-direction: column; padding: 4px 10px; }

/* ── Card ────────────────────────────────────────────────────────────────── */
.er-card {
    flex-direction: column; margin-bottom: 8px; padding: 8px;
    background-color: rgba(34, 44, 56, 0.55);
    border-width: 1px; border-color: rgba(255,255,255,0.08); border-radius: 10px;
    flex-shrink: 0;
}
.er-card:hover { background-color: rgba(46, 60, 76, 0.65); border-color: rgba(92,155,196,0.35); }

.er-card-body { flex-direction: row; }

/* Left column: identity + stats */
.er-left { flex-grow: 1; flex-shrink: 1; flex-direction: column; padding-right: 8px; }
.er-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 15px; letter-spacing: -1px; color: #EAF4FF; white-space: normal;
}
.er-id {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 10px; color: #7A99B0; margin-bottom: 6px;
}

/* Stat rows: [name] [%] [bar] */
.er-stat-row { flex-direction: row; align-items: center; margin-bottom: 3px; }
.er-stat-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 9px; letter-spacing: -1px; width: 42px; flex-shrink: 0;
}
.er-stat-val {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 10px; width: 34px; flex-shrink: 0; -unity-text-align: middle-right; margin-left: 6px;
    color: #CFE2F0;
}
.er-bar-bg {
    flex-grow: 1; height: 9px; background-color: rgba(0,0,0,0.45);
    border-radius: 4px; overflow: hidden;
}
.er-bar-fill { height: 100%; border-radius: 4px; }
.er-fatigue { color: #DC3C3C; } .er-fatigue-fill { background-color: #DC3C3C; }
.er-safety  { color: #ECC928; } .er-safety-fill  { background-color: #ECC928; }
.er-morale  { color: #50C864; } .er-morale-fill  { background-color: #50C864; }
.er-skill   { color: #F0F0F0; } .er-skill-fill   { background-color: #F0F0F0; }

.er-level {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px; letter-spacing: -1px; color: #96BEDC; margin-top: 4px;
}

/* Right column: photo + task */
.er-right { width: 104px; flex-shrink: 0; flex-direction: column; }
.er-avatar {
    height: 96px; border-radius: 8px;
    background-color: rgba(22, 28, 36, 0.80);
    border-width: 2px; border-color: #5C9BC4;
    /* Crop from the TOP (not center) so the face shows, not the torso. */
    background-size: cover;
    background-position-y: top;
    background-repeat: no-repeat;
}
.er-task-bar {
    flex-direction: column; align-items: center; margin-top: 4px;
    background-color: transparent; padding: 0;
}
.er-task-icon {
    width: 64px; height: 64px; flex-shrink: 0;
    background-color: rgba(210, 215, 220, 0.9); border-radius: 10px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.2);
    padding: 10px;
    -unity-background-scale-mode: scale-to-fit;
}
.er-task-name {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 13px; letter-spacing: -1px; color: #CFE2F0; white-space: normal; flex-shrink: 1;
    margin-bottom: 4px;
}

/* Actions dropdown across the bottom */
.er-actions { margin-top: 8px; }
.er-actions .unity-base-popup-field__input {
    background-color: rgba(76,144,192,0.20); border-color: #4C90C0; border-width: 1px; border-radius: 6px;
}
.er-actions .unity-base-popup-field__text {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 12px; color: #DCEAF5;
}

/* Empty state */
.er-empty {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px; color: #7A99B0; -unity-text-align: middle-center; padding: 30px 0;
}

/* Scrollbar */
.er-scroll .unity-scroller--vertical { width: 8px; }
.er-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(92,155,196,0.35); border-radius: 4px;
}

/* Summary box at bottom */
.er-summary-box {
    flex-shrink: 0; height: 50px;
    background-color: rgba(76, 144, 192, 0.25);
    border-top-width: 1px; border-top-color: rgba(92,155,196,0.35);
    align-items: center; justify-content: center;
    padding: 0; margin: 0;
}
.er-summary-text {
    -unity-font-definition: url("project://database/Assets/6.%20Art/UI%20Packs/Farm%20Game%20UI%20-%20Simple%202D%20UI/Font/LilitaOne-Regular.ttf?fileID=12800000&guid=b0b25c7081699704f917d02e28f31692&type=3#LilitaOne-Regular");
    font-size: 14px; color: #CFE2F0; -unity-text-align: middle-center;
}
